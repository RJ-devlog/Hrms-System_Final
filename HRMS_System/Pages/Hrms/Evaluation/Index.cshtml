@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Tabs
        document.querySelectorAll(".tab-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
                document.querySelectorAll(".tab-content").forEach(t => t.classList.remove("active"));

                btn.classList.add("active");
                document.getElementById(btn.dataset.tab).classList.add("active");
            });
        });

        // Print
        document.getElementById("btnPrint")?.addEventListener("click", () => window.print());

        // Quick summary + optional overall calc
        const selEmp = document.querySelector('[name="Input.UserId"]');
        const selPeriod = document.querySelector('[name="Input.Period"]');
        const inpDate = document.querySelector('[name="Input.EvaluationDate"]');
        const overall = document.querySelector('[name="Input.OverallRating"]');

        function getCheckedValue(name) {
            const el = document.querySelector(`input[name="${name}"]:checked`);
            return el ? parseInt(el.value) : null;
        }

        function calcOverall() {
            const vals = [
                getCheckedValue("Input.WorkQuality"),
                getCheckedValue("Input.Productivity"),
                getCheckedValue("Input.Teamwork"),
                getCheckedValue("Input.Attendance"),
                getCheckedValue("Input.Communication"),
            ].filter(v => v !== null);

            if (!vals.length) return "";
            const avg = (vals.reduce((a, b) => a + b, 0) / vals.length).toFixed(2);
            return avg;
        }

        function updateSummary() {
            const empText = selEmp?.selectedOptions?.[0]?.text ?? "—";
            const periodText = selPeriod?.value ?? "—";
            const dateText = inpDate?.value ?? "—";

            const avg = calcOverall();
            if (overall) overall.value = avg;

            document.getElementById("sumEmployee").textContent = (selEmp?.value ? empText : "—");
            document.getElementById("sumPeriod").textContent = (periodText && periodText !== "" ? periodText : "—");
            document.getElementById("sumDate").textContent = (dateText && dateText !== "" ? dateText : "—");
            document.getElementById("sumOverall").textContent = (avg && avg !== "" ? avg : "—");
        }

        ["change", "input"].forEach(evt => {
            selEmp?.addEventListener(evt, updateSummary);
            selPeriod?.addEventListener(evt, updateSummary);
            inpDate?.addEventListener(evt, updateSummary);
        });

        document.querySelectorAll('input[type="radio"]').forEach(r => r.addEventListener("change", updateSummary));
        updateSummary();

        // (Optional) Activity search filter (frontend only)
        function filterActivity() {
            const q = (document.getElementById("actSearch")?.value || "").toLowerCase();
            document.querySelectorAll("#activityBody tr").forEach(tr => {
                const text = tr.innerText.toLowerCase();
                tr.style.display = text.includes(q) ? "" : "none";
            });
        }
        document.getElementById("actSearch")?.addEventListener("input", filterActivity);

        //MODAL VIEW DISPLAY
             function openEvalModal(id) {
            document.getElementById("evalOverlay").style.display = "block";
            document.getElementById("evalModal").style.display = "block";

            // reset
            document.getElementById("vEmployee").innerText = "Loading...";
            document.getElementById("vPeriod").innerText = "—";
            document.getElementById("vDate").innerText = "—";
            document.getElementById("vStrengths").innerText = "—";
            document.getElementById("vImprovements").innerText = "—";
            document.getElementById("vComments").innerText = "—";
            document.getElementById("vOverall").innerText = "—";
            document.getElementById("vRatings").innerHTML = `<tr><td colspan="2">Loading...</td></tr>`;

            fetch(`?handler=EvalDetails&id=${id}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load evaluation");
                    return res.json();
                })
                .then(data => {
                    document.getElementById("vSub").innerText = `Eval ID: EV-${String(data.id).padStart(4, "0")}`;
                    document.getElementById("vEmployee").innerText = data.employee || "—";
                    document.getElementById("vPeriod").innerText = data.period || "—";
                    document.getElementById("vDate").innerText = data.date || "—";

                    const rows = [
                        ["Work Quality / Performance", data.workQuality],
                        ["Productivity", data.productivity],
                        ["Teamwork", data.teamwork],
                        ["Attendance & Punctuality", data.attendance],
                        ["Communication", data.communication],
                    ];

                    document.getElementById("vRatings").innerHTML = rows.map(r => `
                        <tr>
                            <td>${r[0]}</td>
                            <td>${(r[1] ?? "-")}</td>
                        </tr>
                    `).join("");

                    document.getElementById("vStrengths").innerText = data.strengths?.trim() ? data.strengths : "—";
                    document.getElementById("vImprovements").innerText = data.improvements?.trim() ? data.improvements : "—";
                    document.getElementById("vComments").innerText = data.comments?.trim() ? data.comments : "—";
                    document.getElementById("vOverall").innerText = data.overall?.trim() ? data.overall : "—";
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById("vRatings").innerHTML = `<tr><td colspan="2">Error loading evaluation.</td></tr>`;
                });
        }

        function closeEvalModal() {
            document.getElementById("evalOverlay").style.display = "none";
            document.getElementById("evalModal").style.display = "none";
        }
    </script>
}
