<div id="performancePanel" class="profile-panel performance-panel">
    <input type="hidden" id="currentPerformanceUserId" />

    <div class="panel-header">
        <h3>📊 Performance Record</h3>
        <button onclick="closePerformancePanel()">×</button>
    </div>

    <div class="panel-body">
        <table class="performance-table">
            <thead>
                <tr>
                    <th style="width:40%;">Field</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                <tr><td>Employee ID</td><td id="perfEmployeeId">—</td></tr>
                <tr><td>Employee Name</td><td id="perfEmployeeName">—</td></tr>
