@page
@model HRMS_System.Pages.Hrms.Evaluation.IndexModel
@{
    ViewData["Title"] = "Evaluation";
    Layout = "/Pages/Hrms/_HRNavigationLayout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard-shared.css" />
<link rel="stylesheet" href="~/css/evaluation.css" />

<style>
    .table-actions {
        position: relative;
        text-align: center;
        overflow: visible;
    }

    .action-menu {
        position: relative;
        display: inline-block;
    }

    .action-btn {
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 18px;
        padding: 6px;
        color: #6b7280;
    }

    .action-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: auto;
        bottom: 30px;
        min-width: 200px;
        background: #f3f4f6;
        border-radius: 14px;
        padding: 6px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        z-index: 9999;
    }

    .dropdown-item {
        display: block;
        width: 100%;
        border: none;
        background: transparent;
        text-align: left;
        padding: 10px 14px;
        font-size: 14px;
        color: #374151;
        text-decoration: none;
        border-radius: 10px;
        transition: background 0.15s ease;
        cursor: pointer;
    }

        .dropdown-item:hover {
            background: #e5e7eb;
        }

    .action-menu.active .action-dropdown {
        display: block;
    }

    .panel-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.3);
        display: none;
        z-index: 90;
    }

    .profile-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        width: 85%;
        max-width: 1300px;
        min-width: 650px;
        max-height: 85vh;
        overflow: auto;
        background: white;
        border-radius: 14px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.18);
        display: none;
        z-index: 100;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        border-bottom: 1px solid #eee;
    }

        .panel-header h3 {
            margin: 0;
        }

        .panel-header button {
            border: none;
            background: none;
            font-size: 20px;
            cursor: pointer;
        }

    .panel-body {
        padding: 20px;
        min-height: 200px;
    }

    .management-panel .panel-body {
        padding: 30px;
    }

    .management-container {
        width: 100%;
    }

    .management-subtitle {
        font-size: 14px;
        color: #444;
        margin-bottom: 16px;
    }

    .management-table-wrap {
        width: 100%;
    }

    .management-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .management-table thead tr {
            border-top: 3px solid #111;
            border-bottom: 2px solid #111;
        }

        .management-table th {
            text-align: left;
            padding: 10px 8px;
            font-weight: 600;
        }

        .management-table td {
            padding: 10px 8px;
        }

    .empty-row {
        text-align: center;
        color: #888;
        padding: 40px 0;
    }

    .performance-panel .panel-body {
        padding: 30px 40px;
    }

    .performance-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .performance-table thead tr {
            border-bottom: 2px solid #111;
        }

        .performance-table th {
            text-align: left;
            padding: 10px 0;
            font-weight: 600;
        }

        .performance-table td {
            padding: 10px 0;
            color: #333;
        }

    .performance-history {
        margin-top: 40px;
        text-align: right;
    }

        .performance-history a {
            color: #1d4ed8;
            font-weight: 500;
            text-decoration: none;
        }

            .performance-history a:hover {
                text-decoration: underline;
            }

    .history-table,
    .evaluation-history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .history-table thead tr,
        .evaluation-history-table thead tr {
            border-bottom: 2px solid #111;
        }

        .history-table th,
        .evaluation-history-table th {
            text-align: left;
            padding: 10px 0;
            font-weight: 600;
        }

        .history-table td,
        .evaluation-history-table td {
            padding: 10px 0;
        }

    .table-wrap {
        overflow-x: auto;
    }

    #tab-performance .card {
        overflow: visible;
    }

    #tab-performance .performance-table-wrap {
        max-height: 380px;
        overflow-y: auto;
        overflow-x: hidden;
        position: relative;
    }

        #tab-performance .performance-table-wrap thead th {
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 3;
        }
</style>

<div class="dashboard-page eval-page">

    <div class="page-header">
        <div>
            <h1 class="page-title">Performance and Evaluation</h1>
            <div class="page-subtitle">Create performance evaluations and manage records.</div>
        </div>

        <div class="page-actions" hidden>
            <button type="button" class="btn btn-ghost" id="btnPrint">Print</button>
        </div>
    </div>

    <div class="tab-menu">
        <button type="button" class="tab-btn active" data-tab="tab-records">Evaluation Records</button>
        <button type="button" class="tab-btn" data-tab="tab-performance">Performance Records</button>
    </div>

    <!-- TAB: RECORDS -->
    <div class="tab-content active" id="tab-records">
        <div class="card">
            <div class="records-top">
                <div class="records-title">Evaluation Records</div>

                <div class="records-tools">
                    <input type="text" class="form-control small" placeholder="Search name / ID..." id="searchBox" />
                    <select class="form-control" asp-for="Input.Period" disabled>
                    </select>
                </div>
            </div>

            <div class="table-wrap">
                <table class="table-fixed">
                    <thead>
                        <tr>
                            <th style="width: 120px;">Eval ID</th>
                            <th style="width: 220px;">Employee</th>
                            <th style="width: 120px;">Period</th>
                            <th style="width: 160px;">Date</th>
                            <th style="width: 140px;">Overall</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="recordsBody">
                        @foreach (var r in Model.Records)
                        {
                            <tr>
                                <td>EV-@r.Id.ToString("0000")</td>
                                <td>
                                    @(r.User != null ? $"{r.User.EmployeeNumber} - {r.User.FirstName} {r.User.LastName}" : $"User #{r.UserId}")
                                </td>
                                <td>@(r.Period >= 1 && r.Period <= 12 ? new DateTime(2000, r.Period, 1).ToString("MMMM") : "-")</td>
                                <td>@r.EvaluationDate.ToString("MMMM d, yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(r.OverallRating) ? "-" : r.OverallRating)</td>
                                <td>
                                    <button type="button" class="btn btn-ghost btn-xs" onclick="openEvalModal(@r.Id)">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <div class="muted">Showing latest evaluations</div>
            </div>
        </div>
    </div>

    <!-- TAB: PERFORMANCE RECORDS -->
    <div class="tab-content" id="tab-performance">
        <div class="card">
            <div class="records-top">
                <div class="records-title">Employees List</div>

                <div class="records-tools active">
                    <input type="text"
                           class="form-control small"
                           placeholder="Search"
                           id="performanceSearchBox" />
                </div>
            </div>

            <div class="table-wrap performance-table-wrap">
                <table class="table-fixed">
                    <thead>
                        <tr>
                            <th style="width:120px;">ID. No</th>
                            <th style="width:260px;">Name</th>
                            <th style="width:220px;">Department</th>
                            <th style="width:220px;">Evaluator Name</th>
                            <th style="width:80px;">Action</th>
                        </tr>
                    </thead>

                    <tbody id="performanceBody">
                        @if (Model.Employees != null && Model.Employees.Any())
                        {
                            foreach (var emp in Model.Employees)
                            {
                                <tr>
                                    <td>@emp.EmployeeNumber</td>
                                    <td>@emp.FirstName @emp.LastName</td>
                                    <td>@(emp.Department ?? "-")</td>
                                    <td>-</td>
                                    <td class="table-actions">
                                        <div class="action-menu">
                                            <button type="button" class="action-btn">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>

                                            <div class="action-dropdown">
                                                @{
                                                    DateTime? nextDate = Model.NextEvaluationDates.ContainsKey(emp.Id)
                                                    ? Model.NextEvaluationDates[emp.Id]
                                                    : null;

                                                    var canEvaluate = !nextDate.HasValue || DateTime.Today >= nextDate.Value.Date;
                                                }

                                                @if (canEvaluate)
                                                {
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            onclick="openEvaluatePanel('@emp.Id', '@emp.EmployeeNumber - @emp.FirstName @emp.LastName')">
                                                        Evaluate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="dropdown-item" disabled>
                                                        Available on @nextDate?.ToString("dd/MM/yyyy")
                                                    </button>
                                                }

                                                <button type="button"
                                                        class="dropdown-item"
                                                        onclick="openPerformancePanel(@emp.Id)">
                                                    Performance Record
                                                </button>

                                                <button type="button"
                                                        class="dropdown-item"
                                                        onclick="openPanel('managementPanel')">
                                                    Evaluation Management
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    No employees found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- VIEW EVALUATION MODAL OVERLAY -->
<div id="evalOverlay" class="log-overlay" onclick="closeEvalModal()"></div>

<!-- VIEW EVALUATION MODAL -->
<div id="evalModal" class="log-modal" style="max-width: 920px;">
    <div class="log-modal-header">
        <div>
            <h3 id="vTitle" style="margin:0;">Evaluation Details</h3>
            <div id="vSub" style="color:#6b7280;font-size:13px;"></div>
        </div>

        <div style="display:flex; gap:10px; align-items:center;">
            <button type="button" class="btn btn-ghost btn-xs" onclick="window.print()">Print</button>
            <button type="button" class="log-close-btn" onclick="closeEvalModal()">×</button>
        </div>
    </div>

    <div class="log-modal-body" style="padding-top: 10px;">
        <div class="row" style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
            <div>
                <div class="text-muted small">Employee</div>
                <div class="fw-semibold" id="vEmployee">—</div>
            </div>
            <div>
                <div class="text-muted small">Period</div>
                <div class="fw-semibold" id="vPeriod">—</div>
            </div>
            <div>
                <div class="text-muted small">Evaluation Date</div>
                <div class="fw-semibold" id="vDate">—</div>
            </div>
        </div>

        <table class="attendance-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th style="width:140px;">Score</th>
                </tr>
            </thead>
            <tbody id="vRatings">
                <tr><td colspan="2">Loading...</td></tr>
            </tbody>
        </table>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-top:12px;">
            <div>
                <div class="text-muted small">Strengths</div>
                <div class="p-3 rounded border" style="background:#fafafa;" id="vStrengths">—</div>
            </div>
            <div>
                <div class="text-muted small">Areas for Improvement</div>
                <div class="p-3 rounded border" style="background:#fafafa;" id="vImprovements">—</div>
            </div>
        </div>

        <div style="margin-top:12px;">
            <div class="text-muted small">Comments</div>
            <div class="p-3 rounded border" style="background:#fafafa;" id="vComments">—</div>
        </div>

        <div style="margin-top:12px; display:flex; justify-content:space-between; align-items:flex-start; gap:24px;">
            <div>
                <div class="text-muted small">Overall Rating</div>
                <div class="fw-semibold" style="font-size:18px;" id="vOverall">—</div>
            </div>

            <div style="text-align:right;">
                <div class="text-muted small" style="font-size:13px;">
                    Evaluated by: <span id="vEvaluatedBy">—</span>
                </div>
                <div class="text-muted small" style="font-size:13px; margin-top:4px;">
                    Date: <span id="vEvaluatedDate">—</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PANEL OVERLAY -->
<div id="panelOverlay" class="panel-overlay" onclick="closePanel()"></div>

<!-- Evaluate Panel -->
<div id="evaluatePanel" class="profile-panel">
    <div class="panel-header">
        <h3>Evaluate Employee</h3>
        <button type="button" onclick="closePanel()">×</button>
    </div>

    <div class="panel-body">
        <form method="post" class="eval-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <input type="hidden" asp-for="Input.UserId" id="modalUserId" />
            <span class="text-danger" asp-validation-for="Input.UserId"></span>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Employee</label>
                    <input type="text"
                           class="form-control"
                           id="modalEmployeeName"
                           value="@Model.EmployeeOptions.FirstOrDefault(e => e.Value == (Model.Input.UserId?.ToString() ?? ""))?.Text"
                           readonly />
                </div>

                <div class="form-group">
                    <label class="form-label">Period</label>
                    <select asp-for="Input.Period" class="form-control" disabled>
                        @foreach (var month in Model.MonthOptions)
                        {
                            <option value="@month.Value" selected="@(Model.Input.Period == int.Parse(month.Value) ? "selected" : null)">
                                @month.Text
                            </option>
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="Input.Period"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Evaluation Year</label>
                    <input type="number" class="form-control" asp-for="Input.EvaluationCurrentYear" min="1990" max="3000" readonly />
                    <span class="text-danger" asp-validation-for="Input.EvaluationCurrentYear"></span>
                </div>
            </div>

            <div class="section-title">Performance Ratings (1 = Low, 5 = Excellent)</div>

            <div class="rating-block">
                <div class="rating-title">Work Quality/Performance</div>
                <div class="rating-scale">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <label class="rate-pill">
                            <input type="radio" asp-for="Input.WorkQuality" value="@i" />
                            <span>@i</span>
                        </label>
                    }
                </div>
                <span class="text-danger" asp-validation-for="Input.WorkQuality"></span>
            </div>

            <div class="rating-block">
                <div class="rating-title">Productivity</div>
                <div class="rating-scale">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <label class="rate-pill">
                            <input type="radio" asp-for="Input.Productivity" value="@i" />
                            <span>@i</span>
                        </label>
                    }
                </div>
                <span class="text-danger" asp-validation-for="Input.Productivity"></span>
            </div>

            <div class="rating-block">
                <div class="rating-title">Teamwork</div>
                <div class="rating-scale">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <label class="rate-pill">
                            <input type="radio" asp-for="Input.Teamwork" value="@i" />
                            <span>@i</span>
                        </label>
                    }
                </div>
                <span class="text-danger" asp-validation-for="Input.Teamwork"></span>
            </div>

            <div class="rating-block">
                <div class="rating-title">Attendance & Punctuality</div>
                <div class="rating-scale">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <label class="rate-pill">
                            <input type="radio" asp-for="Input.Attendance" value="@i" />
                            <span>@i</span>
                        </label>
                    }
                </div>
                <span class="text-danger" asp-validation-for="Input.Attendance"></span>
            </div>

            <div class="rating-block">
                <div class="rating-title">Communication</div>
                <div class="rating-scale">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <label class="rate-pill">
                            <input type="radio" asp-for="Input.Communication" value="@i" />
                            <span>@i</span>
                        </label>
                    }
                </div>
                <span class="text-danger" asp-validation-for="Input.Communication"></span>
            </div>

            <div class="form-row">
                <div class="form-group full">
                    <label class="form-label">Strengths</label>
                    <textarea class="form-control" rows="3" asp-for="Input.Strengths"></textarea>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full">
                    <label class="form-label">Areas for Improvement</label>
                    <textarea class="form-control" rows="3" asp-for="Input.Improvements"></textarea>
                </div>
            </div>

            <div class="overall-row">
                <div class="overall-box">
                    <div class="overall-label">Overall Rating</div>
                    <input class="overall-input" placeholder="0.00" asp-for="Input.OverallRating" readonly />
                </div>

                <div class="overall-actions">
                    <button type="submit" class="btn btn-primary">Save Evaluation</button>
                    <button type="button" class="btn btn-ghost" onclick="closePanel()">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

