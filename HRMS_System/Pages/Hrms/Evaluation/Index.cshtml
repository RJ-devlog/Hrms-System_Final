                <tr><td>Department</td><td id="perfDepartment">—</td></tr>
                <tr><td>Date Hired</td><td id="perfDateHired">—</td></tr>
                <tr><td>Performance Overall Score</td><td id="perfOverallScore">—</td></tr>
            </tbody>
        </table>

        <div class="performance-history">
            <a href="#" onclick="openPerformanceHistory(); return false;">View Performance History</a>
        </div>
    </div>
</div>

<!-- Evaluation History Panel -->
<div id="evaluationHistoryPanel" class="profile-panel evaluation-history-panel">
    <input type="hidden" id="currentEvaluationHistoryUserId" />

    <div class="panel-header">
        <div style="display:flex;align-items:center;gap:12px;">
            <button type="button"
                    onclick="backToManagementPanel()"
                    style="border:none;background:none;font-size:20px;cursor:pointer;">
                ←
            </button>

            <div>
                <h3 style="margin:0;">Evaluation History</h3>
                <div id="evaluationHistorySubtitle" style="font-size:13px; color:#6b7280;"></div>
            </div>
        </div>

        <button type="button" onclick="closePanel()">×</button>
    </div>

    <div class="panel-body">
        <table class="evaluation-history-table">
            <thead>
                <tr>
                    <th style="width:250px;">Evaluation Period</th>
                    <th>Feedback</th>
                </tr>
            </thead>

            <tbody id="evaluationHistoryBody">
                <tr>
                    <td colspan="2">No evaluation history found.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Tabs
        document.querySelectorAll(".tab-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
                document.querySelectorAll(".tab-content").forEach(t => t.classList.remove("active"));

                btn.classList.add("active");
                document.getElementById(btn.dataset.tab).classList.add("active");
            });
        });

        // Print
        document.getElementById("btnPrint")?.addEventListener("click", () => window.print());

        // Search
        document.getElementById("performanceSearchBox")?.addEventListener("input", function () {
            const value = this.value.toLowerCase();
            document.querySelectorAll("#performanceBody tr").forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(value) ? "" : "none";
            });
        });

        // View Evaluation Modal
        function openEvalModal(id) {
            document.getElementById("evalOverlay").style.display = "block";
            document.getElementById("evalModal").style.display = "block";

            document.getElementById("vEmployee").innerText = "Loading...";
            document.getElementById("vPeriod").innerText = "—";
            document.getElementById("vDate").innerText = "—";
            document.getElementById("vStrengths").innerText = "—";
            document.getElementById("vImprovements").innerText = "—";
            document.getElementById("vComments").innerText = "—";
            document.getElementById("vOverall").innerText = "—";
            document.getElementById("vEvaluatedBy").innerText = "—";
            document.getElementById("vEvaluatedDate").innerText = "—";

            document.getElementById("vRatings").innerHTML = `<tr><td colspan="2">Loading...</td></tr>`;

            fetch(`?handler=EvalDetails&id=${id}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load evaluation");
                    return res.json();
                })
                .then(data => {
                    document.getElementById("vSub").innerText = `Eval ID: EV-${String(data.id).padStart(4, "0")}`;
                    document.getElementById("vEmployee").innerText = data.employee || "—";
                    document.getElementById("vPeriod").innerText = data.period || "—";
                    document.getElementById("vDate").innerText = data.date || "—";

                    const rows = [
                        ["Work Quality / Performance", data.workQuality],
                        ["Productivity", data.productivity],
                        ["Teamwork", data.teamwork],
                        ["Attendance & Punctuality", data.attendance],
                        ["Communication", data.communication],
                    ];

                    document.getElementById("vRatings").innerHTML = rows.map(r => `
                        <tr>
                            <td>${r[0]}</td>
                            <td>${(r[1] ?? "-")}</td>
                        </tr>
                    `).join("");

                    document.getElementById("vStrengths").innerText = data.strengths?.trim() ? data.strengths : "—";
                    document.getElementById("vImprovements").innerText = data.improvements?.trim() ? data.improvements : "—";
                    document.getElementById("vComments").innerText = data.comments?.trim() ? data.comments : "—";
                    document.getElementById("vOverall").innerText = data.overall?.trim() ? data.overall : "—";
                    document.getElementById("vEvaluatedBy").innerText = data.evaluatedBy || "—";
                    document.getElementById("vEvaluatedDate").innerText = data.evaluatedDate || "—";
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById("vRatings").innerHTML = `<tr><td colspan="2">Error loading evaluation.</td></tr>`;
                });
        }

        function closeEvalModal() {
            document.getElementById("evalOverlay").style.display = "none";
            document.getElementById("evalModal").style.display = "none";
        }

        // Dropdown
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".action-btn").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    document.querySelectorAll(".action-menu").forEach(menu => {
                        if (menu !== this.closest(".action-menu")) {
                            menu.classList.remove("active");
                        }
                    });

                    this.closest(".action-menu").classList.toggle("active");
                });
            });

            document.addEventListener("click", function () {
                document.querySelectorAll(".action-menu").forEach(menu => {
                    menu.classList.remove("active");
                });
            });
        });

        // Panels
        function openPanel(panelId) {
            document.getElementById("panelOverlay").style.display = "block";
            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
            document.getElementById(panelId).style.display = "block";
        }

        function closePanel() {
            document.getElementById("panelOverlay").style.display = "none";
            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
        }

        function openPerformancePanel(id) {
            document.getElementById("panelOverlay").style.display = "block";

            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
            document.getElementById("performancePanel").style.display = "block";

            document.getElementById("perfEmployeeId").innerText = "Loading...";
            document.getElementById("perfEmployeeName").innerText = "Loading...";
            document.getElementById("perfJobRole").innerText = "Loading...";
            document.getElementById("perfDepartment").innerText = "Loading...";
            document.getElementById("perfDateHired").innerText = "Loading...";
            document.getElementById("perfOverallScore").innerText = "Loading...";

            fetch(`?handler=PerformanceDetails&id=${id}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load performance details");
                    return res.json();
                })
                .then(data => {
                    document.getElementById("currentPerformanceUserId").value = id;
                    document.getElementById("perfEmployeeId").innerText = data.id || "—";
                    document.getElementById("perfEmployeeName").innerText = data.name || "—";
                    document.getElementById("perfJobRole").innerText = data.jobRole || "—";
                    document.getElementById("perfDepartment").innerText = data.department || "—";
                    document.getElementById("perfDateHired").innerText = data.dateHired || "—";
                    document.getElementById("perfOverallScore").innerText = data.overallScore || "—";
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById("perfEmployeeId").innerText = "Error";
                    document.getElementById("perfEmployeeName").innerText = "Error";
                    document.getElementById("perfJobRole").innerText = "Error";
                    document.getElementById("perfDepartment").innerText = "Error";
                    document.getElementById("perfDateHired").innerText = "Error";
                    document.getElementById("perfOverallScore").innerText = "Error";
                });
        }

        function closePerformancePanel() {
            document.getElementById("performancePanel").style.display = "none";
        }

        function openPerformanceHistory() {
            const userId = document.getElementById("currentPerformanceUserId").value;
            if (!userId) return;

            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
            document.getElementById("performanceHistoryPanel").style.display = "block";

            const tbody = document.querySelector("#performanceHistoryPanel tbody");
            tbody.innerHTML = `<tr><td colspan="3">Loading...</td></tr>`;

            fetch(`?handler=PerformanceHistory&id=${userId}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load performance history");
                    return res.json();
                })
                .then(data => {
                    if (!data.length) {
                        tbody.innerHTML = `<tr><td colspan="3">No performance history found.</td></tr>`;
                        return;
                    }

                    tbody.innerHTML = data.map(row => `
                        <tr>
                            <td>${row.year}</td>
                            <td>${row.score}%</td>
                            <td>${row.trend}</td>
                        </tr>
                    `).join("");
                })
                .catch(err => {
                    console.error(err);
                    tbody.innerHTML = `<tr><td colspan="3">Error loading performance history.</td></tr>`;
                });
        }

        function backToPerformancePanel() {
            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
            document.getElementById("performancePanel").style.display = "block";
        }

        function openEvaluationHistoryPanel(userId, employeeName) {
            document.getElementById("panelOverlay").style.display = "block";
            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
            document.getElementById("evaluationHistoryPanel").style.display = "block";

            document.getElementById("currentEvaluationHistoryUserId").value = userId;
            document.getElementById("evaluationHistorySubtitle").innerText = employeeName || "";

            const tbody = document.getElementById("evaluationHistoryBody");
            tbody.innerHTML = `<tr><td colspan="2">Loading...</td></tr>`;

            fetch(`?handler=EvaluationHistory&id=${userId}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load evaluation history");
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.length) {
                        tbody.innerHTML = `<tr><td colspan="2">No evaluation history found.</td></tr>`;
                        return;
                    }

                    tbody.innerHTML = data.map(row => `
                        <tr>
                            <td>${row.period}</td>
                            <td>${row.feedback}</td>
                        </tr>
                    `).join("");
                })
                .catch(err => {
                    console.error(err);
                    tbody.innerHTML = `<tr><td colspan="2">Error loading evaluation history.</td></tr>`;
                });
        }

        function backToManagementPanel() {
            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
            document.getElementById("managementPanel").style.display = "block";
        }

        // Evaluate modal
        function openEvaluatePanel(userId, employeeName) {
            document.getElementById("panelOverlay").style.display = "block";

            document.querySelectorAll(".profile-panel").forEach(p => p.style.display = "none");
            document.getElementById("evaluatePanel").style.display = "block";

            document.getElementById("modalUserId").value = userId;
            document.getElementById("modalEmployeeName").value = employeeName;

            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, "0");
            const dd = String(today.getDate()).padStart(2, "0");

            const dateInput = document.querySelector('#evaluatePanel [name="Input.EvaluationDate"]');
            const periodSelect = document.querySelector('#evaluatePanel select[name="Input.Period"]');
            const yearInput = document.querySelector('#evaluatePanel [name="Input.EvaluationCurrentYear"]');

            if (periodSelect) {
                periodSelect.value = "@Model.Input.Period";
                periodSelect.disabled = true;
            }

            if (dateInput && !dateInput.value) {
                dateInput.value = `${yyyy}-${mm}-${dd}`;
            }

            if (yearInput && !yearInput.value) {
                yearInput.value = yyyy;
            }

            updateModalOverall();
        }

        function getCheckedValueInModal(name) {
            const panel = document.getElementById("evaluatePanel");
            const el = panel.querySelector(`input[name="${name}"]:checked`);
            return el ? parseInt(el.value) : null;
        }

        function calcOverallInModal() {
            const vals = [
                getCheckedValueInModal("Input.WorkQuality"),
                getCheckedValueInModal("Input.Productivity"),
                getCheckedValueInModal("Input.Teamwork"),
                getCheckedValueInModal("Input.Attendance"),
                getCheckedValueInModal("Input.Communication")
            ].filter(v => v !== null);

            if (!vals.length) return "";
            return (vals.reduce((a, b) => a + b, 0) / vals.length).toFixed(2);
        }

        function updateModalOverall() {
            const panel = document.getElementById("evaluatePanel");
            const overallInput = panel.querySelector('[name="Input.OverallRating"]');
            if (!overallInput) return;
            overallInput.value = calcOverallInModal();
        }

        document.addEventListener("DOMContentLoaded", function () {
            const panel = document.getElementById("evaluatePanel");
            if (!panel) return;

            panel.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.addEventListener("change", updateModalOverall);
            });

            updateModalOverall();
        });
    </script>
}

