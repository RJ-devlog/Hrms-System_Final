            document.getElementById("evaluatePanel").style.display = "block";

            const hiddenUserId = document.getElementById("modalUserId");
            const employeeName = document.getElementById("modalEmployeeName");

            if (hiddenUserId && employeeName && !employeeName.value) {
                const selected = document.querySelector(`#performanceBody button[onclick*="openEvaluatePanel('${hiddenUserId.value}'"]`);
                if (selected) {
                    // fallback only if needed
                }
            }

            updateModalOverall();
        });
    </script>
