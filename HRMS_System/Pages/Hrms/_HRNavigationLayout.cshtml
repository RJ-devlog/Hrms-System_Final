@using HRMS_System.Enums
@using HRMS_System.Models
@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - HRMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    @{
        bool bellAnimate = TempData["NewNotif"] != null;

        var roleClaim = User.FindFirstValue(ClaimTypes.Role);
        Enum.TryParse<AccessRole>(roleClaim, true, out var role);

        bool isEmployee = role == AccessRole.Employee;
        bool isHR = role == AccessRole.HR;
        bool isSupervisor = role == AccessRole.Supervisor;
        bool isManager = role == AccessRole.Manager;
        bool isCEO = role == AccessRole.CEO;
        bool isAdmin = role == AccessRole.Admin;

        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

        string IsActive(string pagePrefix)
        {
            return currentPage.StartsWith(pagePrefix, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
        }
    }

    <div class="app-container">

        <div class="sidebar">
            <div class="sidebar-logo">
                <img src="~/Icons/Logo.png" />
            </div>

            <ul class="sidebar-menu">

                @if (isHR || isAdmin)
                {
                    <li class="menu-item @IsActive("/Hrms/EmployeeManagement")">
                        <a asp-page="/Hrms/EmployeeManagement/Index">
                            <i class="bi bi-person"></i>
                            <span>Employee Management</span>
                        </a>
                    </li>
                }

                @if (isHR || isAdmin)
                {
                    <li class="menu-item @IsActive("/Hrms/TrainingandSeminar")">
                        <a asp-page="/Hrms/TrainingandSeminar/Index">
                            <i class="bi bi-mortarboard"></i>
                            <span>Training & Seminars</span>
                        </a>
                    </li>
                }

                @if (isHR || isAdmin)
                {
                    <li class="menu-item @IsActive("/Hrms/AttendanceTracking")">
                        <a asp-page="/Hrms/AttendanceTracking/Index">
                            <i class="bi bi-clock-history"></i>
                            <span>Attendance Tracking</span>
                        </a>
                    </li>
                }

                @if (isHR || isAdmin || isManager || isSupervisor)
                {
                    <li class="menu-item @IsActive("/Hrms/Evaluation")">
                        <a asp-page="/Hrms/Evaluation/Index">
                            <i class="bi bi-card-checklist"></i>
                            <span>Performance and Evaluation</span>
                        </a>
                    </li>
                }

                @if (isAdmin || isCEO || isHR)
                {
                    <li class="menu-item @IsActive("/Hrms/ReportManagement")">
                        <a asp-page="/Hrms/ReportManagement/Index">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>Report Management</span>
                        </a>
                    </li>
                }

                @if (isHR || isAdmin || isCEO)
                {
                    <li class="menu-item @IsActive("/Hrms/PromotionManagement")">
                        <a asp-page="/Hrms/PromotionManagement/Index">
                            <i class="bi bi-arrow-up-right-circle"></i>
                            <span>Promotion Management</span>
                        </a>
                    </li>
                }

                @if (isHR || isAdmin)
                {
                    <li class="menu-item @IsActive("/Hrms/Notification")">
                        <a asp-page="/Hrms/Notification/Index">
                            <span class="bell @(bellAnimate ? "bell-animate" : "")">
                                <i class="bi bi-bell"></i>
                                @if (bellAnimate)
                                {
                                    <span class="notif-dot"></span>
                                }
                            </span>
                            <span>Notification</span>
                        </a>
                    </li>
                }

            </ul>

            <div class="sidebar-footer dropdown">
                <a href="#"
                   class="sidebar-footer-trigger"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <i class="bi bi-person-circle"></i>
                    <span>@(roleClaim ?? "Account")</span>
                </a>

                <ul class="dropdown-menu dropdown-menu-end sidebar-dd">
                    <li>
                        <a class="dropdown-item sidebar-dd-item" asp-page="/HRMS/ViewProfile/Index">
                            <i class="bi bi-person-circle me-2"></i> My Profile
                        </a>
                        <a class="dropdown-item sidebar-dd-item" asp-page="/Account/ChangePassword">
                            <i class="bi bi-shield-lock me-2"></i> Change Password
                        </a>
                        <a class="dropdown-item sidebar-dd-item" asp-page="/Account/LogoutPage">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>