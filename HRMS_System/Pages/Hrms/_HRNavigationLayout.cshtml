@using HRMS_System.Models
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - HRMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    @{
        bool bellAnimate = TempData["NewNotif"] != null;

        // Read role from claims
        var roleClaim = User.FindFirst("UserRole")?.Value;
        Enum.TryParse<UserRole>(roleClaim, out var role);

        bool isHR = role == UserRole.HR;
        bool isSupervisor = role == UserRole.Supervisor;
        bool isManager = role == UserRole.Manager;
        bool isCEO = role == UserRole.CEO;

        // Helper: show item if HR OR role is allowed
        bool Can(params UserRole[] allowed) => isHR || allowed.Contains(role);
    }

    <div class="app-container">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-logo">
                <img src="~/Icons/Logo.png" />
            </div>

            <ul class="sidebar-menu">

                @* Employee Management: HR only *@
                @if (Can())  @* HR only because allowed list is empty and HR always passes *@
                {
                    <li class="menu-item">
                        <a asp-page="/Hrms/EmployeeManagement/Index">
                            <i class="bi bi-person"></i>
                            <span>Employee Management</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a asp-page="/Hrms/TrainingandSeminar/Index">
                            <i class="bi bi-mortarboard"></i>
                            <span>Training & Seminars</span>
                        </a>
                    </li>
                }

                @* Attendance Tracking: Manager (and HR) *@
                @if (Can(UserRole.Manager))
                {
                    <li class="menu-item">
                        <a asp-page="/Hrms/AttendanceTracking/Index">
                            <i class="bi bi-clock-history"></i>
                            <span>Attendance Tracking</span>
                        </a>
                    </li>
                }

                @* Evaluation: Supervisor (and HR) *@
                @if (Can(UserRole.Supervisor))
                {
                    <li class="menu-item">
                        <a asp-page="/Hrms/Evaluation/Index">
                            <i class="bi bi-card-checklist"></i>
                            <span>Evaluation</span>
                        </a>
                    </li>
                }

                @* Report Management: Manager + CEO (and HR) *@
                @if (Can(UserRole.Manager, UserRole.CEO))
                {
                    <li class="menu-item">
                        <a asp-page="/Hrms/ReportManagement/Index">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>Report Management</span>
                        </a>
                    </li>
                }

                @* Promotion Management: CEO (and HR) *@
                @if (Can(UserRole.CEO))
                {
                    <li class="menu-item">
                        <a asp-page="/Hrms/PromotionManagement/Index">
                            <i class="bi bi-arrow-up-right-circle"></i>
                            <span>Promotion Management</span>
                        </a>
                    </li>
                }

                @* Notification: Manager (and HR) *@
                @if (Can(UserRole.Manager))
                {
                    <li class="menu-item">
                        <a asp-page="/Hrms/Notification/Index">
                            <span class="bell @(bellAnimate ? "bell-animate" : "")">
                                <i class="bi bi-bell"></i>
                                @if (bellAnimate)
                                {
                                    <span class="notif-dot"></span>
                                }
                            </span>
                            <span>Notification</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="sidebar-footer dropdown">
                <a href="#"
                   class="sidebar-footer-trigger"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <i class="bi bi-person-circle"></i>
                    <span>@(User.FindFirst("UserRole")?.Value ?? "Account")</span>
                </a>

                <ul class="dropdown-menu dropdown-menu-end sidebar-dd">
                    <li>
                        <a class="dropdown-item sidebar-dd-item" asp-page="/HRMS/ViewProfile/Index">
                            <i class="bi bi-person-circle me-2"></i> My Profile
                        </a>
                        <a class="dropdown-item sidebar-dd-item" asp-page="/Account/ChangePassword">
                            <i class="bi bi-shield-lock me-2"></i> Change Password
                        </a>
                        <a class="dropdown-item sidebar-dd-item" asp-page="/Account/LogoutPage">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div> <!--  sidebar -->
        <!-- MAIN CONTENT -->
        <div class="main-content">
            @RenderBody()
        </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>