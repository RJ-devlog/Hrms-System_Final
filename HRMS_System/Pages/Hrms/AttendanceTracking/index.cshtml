@page
@model HRMS_System.Pages.Hrms.AttendanceTracking.AttendanceTrackingPageModel
@{
    ViewData["Title"] = "Attendance Tracking";
    Layout = "/Pages/Hrms/_HRNavigationLayout.cshtml";
}
@functions {
    string GetAttendanceStatus(DateTime? timeIn, DateTime? timeOut)
    {
        if (!timeIn.HasValue) return "Absent";

        if (!timeOut.HasValue) return "Incomplete";

        var lateCutoff = new TimeSpan(8, 0, 0); // 8:00 AM
        if (timeIn.Value.TimeOfDay > lateCutoff) return "Late";

        return "On-Time";
    }

    string GetStatusClass(string status)
    {
        return status switch
        {
            "On-Time" => "status-ontime",
            "Late" => "status-late",
            "Absent" => "status-absent",
            "Incomplete" => "status-incomplete",
            _ => ""
        };
    }
}


<div class="dashboard-page">

    <h1 class="page-title">Attendance Tracking</h1>
    <div class="title-line"></div>

    <!-- TOP BAR -->
    <div class="attendance-topbar">
        <div class="attendance-tabs">
            <div class="attendance-tab active" data-tab="time">Time In/Out</div>
            <div class="attendance-tab" data-tab="date">Date Tracking</div>
            <div class="attendance-tab" data-tab="summary">Attendance Summary</div>
        </div>

        <input type="text"
               class="attendance-search"
               id="attendanceSearch"
               placeholder="Search Employee" />
    </div>

    <!-- TAB CONTENT WRAPPER -->
    <div class="attendance-content-wrapper">

        <!-- TIME IN / TIME OUT VIEW -->
        <div class="tab-content active" id="tab-time">
            <table class="attendance-table">
                <thead>
                    <tr>
                        <th class="th-sort" data-sort="id" data-type="number">ID No. <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="name" data-type="string">Name <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="date" data-type="date">Date <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="timein" data-type="time">Time In <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="timeout" data-type="time">Time Out <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="status" data-type="string">Status <span class="sort-icon"></span></th>
                    </tr>
                </thead>
                <tbody id="timeTbody">
                    @foreach (var a in Model.DateRangeAttendance)
                    {
                        var status = GetAttendanceStatus(a.TimeIn, a.TimeOut);

                        <tr>
                            <td>@a.User.EmployeeNumber.Split('-')[1]</td>
                            <td>@a.User.FirstName @a.User.LastName</td>
                            <td>@a.AttendanceDate.ToString("MMMM d, yyyy")</td>
                            <td>@(a.TimeIn?.ToString("hh:mm tt") ?? "-")</td>
                            <td>@(a.TimeOut?.ToString("hh:mm tt") ?? "-")</td>
                            <td>
                                <span class="status-badge @GetStatusClass(status)">@status</span>
                            </td>
                     @*        <td style="position: relative; text-align: center;">
                                <i class="bi bi-three-dots-vertical table-options"></i>
                                <div class="table-dropdown">
                                    <a href="javascript:void(0)" onclick="openLog(@a.UserId)">View Log</a>
                                </div>
                            </td> *@
                        </tr>
                    }

                    @if (!Model.DateRangeAttendance.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align:center;color:#6b7280;">No records found.</td>
                        </tr>
                    }
                </tbody>



            </table>
        </div>

        <!-- ATTENDANCE SUMMARY VIEW -->
        <div class="tab-content" id="tab-summary">

            <!-- SUMMARY HEADER (must be inside the box) -->
            <div class="attendance-summary-header">
                <div class="summary-month">
                    <!-- Visible UI (matches your design) -->
                    <button type="button" class="summary-month-btn" id="summaryMonthBtn">
                        <strong id="summaryMonthText">@Model.SummaryMonth.ToString("MMMM yyyy")</strong>
                        <span class="summary-cal-icon">
                            <i class="bi bi-calendar3"></i>
                        </span>
                    </button>

                    <!-- Real picker (invisible but clickable via JS) -->
                    <input type="month"
                           id="summaryMonthInput"
                           class="summary-month-input"
                           value="@Model.SummaryMonth.ToString("yyyy-MM")"
                           min="2000-01"
                           max="2100-12" />
                </div>

                <div class="summary-days">
                    Total Work Days: <strong>@Model.TotalWorkDays</strong>
                </div>
            </div>


            <!-- SUMMARY TABLE -->
            <table class="attendance-table">
                <thead>
                    <tr>
                        <th class="th-sort" data-sort="id" data-type="number">ID No. <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="name" data-type="string">Name <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="ontime" data-type="number">On-Time <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="late" data-type="number">Late <span class="sort-icon"></span></th>
                        <th class="th-sort" data-sort="absent" data-type="number">Absent <span class="sort-icon"></span></th>
                    </tr>
                </thead>
                <tbody id="summaryTbody">
                    @foreach (var s in Model.AttendanceSummary)
                    {
                        <tr>
                            <td>@s.EmployeeNumber.Split('-')[1]</td>
                            <td>@s.FullName</td>
                            <td class="text-green">@s.OnTime</td>
                            <td class="text-orange">@s.Late</td>
                            <td class="text-red">@s.Absent</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <!-- DATE TRACKING VIEW -->
        <div class="tab-content" id="tab-date">

            <!-- FILTER BAR -->
            <form method="get" class="date-tracking-bar">
                <input type="hidden" name="tab" value="date" />
                <div class="date-field">
                    <label>Date From</label>
                    <input type="date" name="from" id="dateFrom" class="date-input"
                           value="@(Request.Query["from"])" />
                </div>

                <div class="date-field">
                    <label>Date To</label>
                    <input type="date" name="to" id="dateTo" class="date-input"
                           value="@(Request.Query["to"])" />
                </div>

                <button type="submit" class="date-filter-btn">
                    Filter
                </button>
            </form>

            <!-- TABLE -->
            <table class="attendance-table">
                <thead>
                    <tr>
                        <th class="th-sort" data-sort="id" data-type="number">
                            ID No. <span class="sort-icon"></span>
                        </th>

                        <th class="th-sort" data-sort="name" data-type="string">
                            Name <span class="sort-icon"></span>
                        </th>

                        <th class="th-sort" data-sort="date" data-type="date">
                            Date <span class="sort-icon"></span>
                        </th>

                        <th class="th-sort" data-sort="timein" data-type="time">
                            Time In <span class="sort-icon"></span>
                        </th>

                        <th class="th-sort" data-sort="timeout" data-type="time">
                            Time Out <span class="sort-icon"></span>
                        </th>

                        <th class="th-sort" data-sort="status" data-type="string">
                            Status <span class="sort-icon"></span>
                        </th>

                        <th>Attendance Log</th>
                    </tr>
                </thead>


                <tbody id="dateTbody">
                    @foreach (var a in Model.DateRangeAttendance)
                    {
                        var status = GetAttendanceStatus(a.TimeIn, a.TimeOut);

                        <tr>
                            <td>@a.User.EmployeeNumber.Split('-')[1]</td>
                            <td>@a.User.FirstName @a.User.LastName</td>
                            <td>@a.AttendanceDate.ToString("MMMM d, yyyy")</td>
                            <td>@(a.TimeIn?.ToString("hh:mm tt") ?? "-")</td>
                            <td>@(a.TimeOut?.ToString("hh:mm tt") ?? "-")</td>
                            <td>
                                <span class="status-badge @GetStatusClass(status)">@status</span>
                            </td>
                            <td style="position: relative; text-align: center;">
                                <i class="bi bi-three-dots-vertical table-options"></i>
                                <div class="table-dropdown">
                                    <a href="javascript:void(0)" onclick="openLog(@a.UserId)">View Log</a>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.DateRangeAttendance.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align:center;color:#6b7280;">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>


    </div>
</div>
<!-- LOG MODAL OVERLAY -->
<div id="logOverlay" class="log-overlay" onclick="closeLog()"></div>

<!-- LOG MODAL -->
<div id="logModal" class="log-modal">
    <div class="log-modal-header">
        <div>
            <h3 id="empName" style="margin:0;"></h3>
            <div id="employeeID" style="color:#6b7280;font-size:13px;"></div>
        </div>
        <button type="button" class="log-close-btn" onclick="closeLog()">×</button>
    </div>


    <div class="log-modal-body">

        <!-- FILTER BAR  -->
        <div class="log-filter-row">
            <div class="log-field">
                <label for="logDateFrom">Date From</label>
                <input type="date" id="logDateFrom" class="log-date-input" />
            </div>

            <div class="log-field">
                <label for="logDateTo">Date To</label>
                <input type="date" id="logDateTo" class="log-date-input" />
            </div>

            <button type="button" class="log-filter-btn" onclick="applyLogFilter()">
                Filter
            </button>
        </div>

        <table class="attendance-table">
            <thead>
                <tr>
                    <th class="th-sort" data-sort="log-date" data-type="date">
                        Date <span class="sort-icon"></span>
                    </th>

                    <th class="th-sort" data-sort="log-timein" data-type="time">
                        Time In <span class="sort-icon"></span>
                    </th>

                    <th class="th-sort" data-sort="log-timeout" data-type="time">
                        Time Out <span class="sort-icon"></span>
                    </th>

                    <th class="th-sort" data-sort="log-status" data-type="string">
                        Status <span class="sort-icon"></span>
                    </th>
                </tr>
            </thead>

            <tbody id="logTbody">
                <tr><td colspan="4">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        let currentLogUserId = null;

        document.addEventListener("DOMContentLoaded", function () {

            // Tabs
            const tabs = document.querySelectorAll(".attendance-tab");
            const contents = {
                time: document.getElementById("tab-time"),
                summary: document.getElementById("tab-summary"),
                date: document.getElementById("tab-date")
            };

            tabs.forEach(t => {
                t.addEventListener("click", function () {
                    tabs.forEach(x => x.classList.remove("active"));
                    this.classList.add("active");

                    Object.values(contents).forEach(c => c && c.classList.remove("active"));
                    const key = this.getAttribute("data-tab");
                    if (contents[key]) contents[key].classList.add("active");
                });
            });

            // Restore active tab from URL (?tab=summary / ?tab=date / ?tab=time)
            const params = new URLSearchParams(window.location.search);
            const tabFromUrl = params.get("tab");

            if (tabFromUrl && contents[tabFromUrl]) {
                tabs.forEach(x => x.classList.remove("active"));
                Object.values(contents).forEach(c => c && c.classList.remove("active"));

                document.querySelector(`.attendance-tab[data-tab="${tabFromUrl}"]`)?.classList.add("active");
                contents[tabFromUrl].classList.add("active");
            }

            // Search
            const search = document.getElementById("attendanceSearch");
            search.addEventListener("input", function () {
                const q = this.value.toLowerCase().trim();
                const activeContent = document.querySelector(".tab-content.active");
                if (!activeContent) return;

                const rows = activeContent.querySelectorAll("tbody tr");
                rows.forEach(r => {
                    const text = r.innerText.toLowerCase();
                    r.style.display = text.includes(q) ? "" : "none";
                });
            });

        // Date filter (Date Tracking tab)
        const btn = document.getElementById("applyDateFilter");
        const dateFrom = document.getElementById("dateFrom");
        const dateTo = document.getElementById("dateTo");
        const tbody = document.getElementById("dateTbody");

        // ✅ store original rows ONCE
        const originalRows = tbody ? Array.from(tbody.querySelectorAll("tr")) : [];
        if (btn && dateFrom && dateTo && tbody) {
            btn.addEventListener("click", function () {
                const fromVal = dateFrom.value;
                const toVal = dateTo.value;

                const url = new URL(window.location.href);
                url.searchParams.set("tab", "date");

                if (fromVal) url.searchParams.set("from", fromVal);
                else url.searchParams.delete("from");

                if (toVal) url.searchParams.set("to", toVal);
                else url.searchParams.delete("to");

                window.location.href = url.toString();
            });
        }

            // Dropdown menu (⋮)
            document.querySelectorAll(".table-options").forEach(icon => {
                icon.addEventListener("click", function (e) {
                    e.stopPropagation();
                    const dropdown = this.nextElementSibling;
                    if (!dropdown) return;

                    document.querySelectorAll(".table-dropdown").forEach(d => {
                        if (d !== dropdown) d.classList.remove("show");
                    });

                    dropdown.classList.toggle("show");
                });
            });

            document.addEventListener("click", function () {
                document.querySelectorAll(".table-dropdown").forEach(d => d.classList.remove("show"));
            });

            // ✅ SUMMARY MONTH PICKER
            const summaryInput = document.getElementById("summaryMonthInput");

            if (summaryInput) {
                summaryInput.addEventListener("change", function () {
                    const val = summaryInput.value; // YYYY-MM
                    if (!val) return;

                    const url = new URL(window.location.href);
                    url.searchParams.set("summaryMonth", val);
                    url.searchParams.set("tab", "summary"); //stay on summary after reload
                    window.location.href = url.toString();
                });
            }

            //-------------DATE PICKER--------------//

            const summaryBtn = document.getElementById("summaryMonthBtn");
            if (summaryBtn && summaryInput) {
                summaryBtn.addEventListener("click", function () {
                    // Chrome/Edge supports showPicker()
                    if (typeof summaryInput.showPicker === "function") {
                        summaryInput.showPicker();
                    } else {
                        // Fallback for other browsers
                        summaryInput.focus();
                        summaryInput.click();
                    }
                });
                summaryInput.addEventListener("change", function () {
                    const val = summaryInput.value; // YYYY-MM
                    if (!val) return;

                    const url = new URL(window.location.href);
                    url.searchParams.set("summaryMonth", val);
                    window.location.href = url.toString();
                });
            }

        });

        // Modal open
        function openLog(userId) {
            currentLogUserId = userId;

            document.getElementById("logOverlay").style.display = "block";
            document.getElementById("logModal").style.display = "block";

            //keep inputs empty (shows mm/dd/yyyy)
            document.getElementById("logDateFrom").value = "";
            document.getElementById("logDateTo").value = "";

            loadEmployeeLogs(); //will load default range
        }


        function loadEmployeeLogs() {
            const from = document.getElementById("logDateFrom").value;
            const to = document.getElementById("logDateTo").value;

            let url = `?handler=EmployeeLogs&id=${currentLogUserId}`;
            if (from) url += `&from=${from}`;
            if (to) url += `&to=${to}`;

            const tbody = document.getElementById("logTbody");
            tbody.innerHTML = `<tr><td colspan="4">Loading...</td></tr>`;

            fetch(url)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load logs");
                    return res.json();
                })
                .then(data => {
                    document.getElementById("empName").innerText = data.fullName;
                    document.getElementById("employeeID").innerText = `ID: ${data.employeeNumber}`;

                    if (!data.logs || data.logs.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="4">No records found.</td></tr>`;
                        return;
                    }

                    tbody.innerHTML = "";
                    data.logs.forEach(x => {
                        const statusClass =
                            x.status === "On-Time" ? "status-ontime" :
                            x.status === "Late" ? "status-late" :
                            x.status === "Absent" ? "status-absent" :
                            "status-incomplete";

                        tbody.insertAdjacentHTML("beforeend", `
                            <tr>
                                <td>${x.date}</td>
                                <td>${x.timeIn ?? "-"}</td>
                                <td>${x.timeOut ?? "-"}</td>
                                <td><span class="status-badge ${statusClass}">${x.status}</span></td>
                            </tr>
                        `);
                    });
                })
                .catch(err => {
                    console.error(err);
                    tbody.innerHTML = `<tr><td colspan="4">Error loading logs.</td></tr>`;
                });
        }

        function applyLogFilter() {
            if (!currentLogUserId) return;
            loadEmployeeLogs();
        }

        function closeLog() {
            document.getElementById("logOverlay").style.display = "none";
            document.getElementById("logModal").style.display = "none";

            currentLogUserId = null;

            document.getElementById("logDateFrom").value = "";
            document.getElementById("logDateTo").value = "";

            document.getElementById("logTbody").innerHTML =
                `<tr><td colspan="4" style="text-align:center;color:#6b7280;">No employee selected.</td></tr>`;
        }
                (function () {
            function parseTimeToMinutes(text) {
                text = (text || "").trim();
                if (!text || text === "-") return -1;

                const m = text.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
                if (!m) return -1;

                let h = parseInt(m[1], 10);
                const mins = parseInt(m[2], 10);
                const ap = m[3].toUpperCase();

                if (ap === "PM" && h !== 12) h += 12;
                if (ap === "AM" && h === 12) h = 0;

                return h * 60 + mins;
            }

            function toComparable(text, type) {
                const v = (text ?? "").toString().trim();

                if (type === "number") {
                    const n = parseInt(v.replace(/[^\d\-]/g, ""), 10);
                    return Number.isFinite(n) ? n : -1;
                }

                if (type === "date") {
                    const d = Date.parse(v); // "January 27, 2026"
                    return Number.isFinite(d) ? d : -1;
                }

                if (type === "time") {
                    return parseTimeToMinutes(v);
                }

                return v.toLowerCase(); // string
            }

            function getValue(row, key) {
                const tds = row.querySelectorAll("td");
                if (!tds.length) return "";

                // Common tables
                // Time/Date: 0=id,1=name,2=date,3=timein,4=timeout,5=status
                // Summary:   0=id,1=name,2=ontime,3=late,4=absent

                switch (key) {
                    case "id": return tds[0]?.innerText ?? "";
                    case "name": return tds[1]?.innerText ?? "";
                    case "date": return tds[2]?.innerText ?? "";
                    case "timein": return tds[3]?.innerText ?? "";
                    case "timeout": return tds[4]?.innerText ?? "";
                    case "status": return tds[5]?.innerText ?? "";

                    case "ontime": return tds[2]?.innerText ?? "";
                    case "late": return tds[3]?.innerText ?? "";
                    case "absent": return tds[4]?.innerText ?? "";

                    // View Log modal (Date, Time In, Time Out, Status)
                    case "log-date": return tds[0]?.innerText ?? "";
                    case "log-timein": return tds[1]?.innerText ?? "";
                    case "log-timeout": return tds[2]?.innerText ?? "";
                    case "log-status": return tds[3]?.innerText ?? "";

                }

                return "";
            }

            function sortTable(th) {
                const table = th.closest("table");
                const tbody = table?.querySelector("tbody");
                if (!table || !tbody) return;

                const key = th.dataset.sort;
                const type = th.dataset.type || "string";

                // toggle direction
                const current = th.getAttribute("data-dir") || "none";
                const dir = current === "asc" ? "desc" : "asc";
                th.setAttribute("data-dir", dir);

                // reset other headers in this same table
                table.querySelectorAll("th.th-sort").forEach(h => {
                    if (h !== th) h.setAttribute("data-dir", "none");
                });

                const rows = Array.from(tbody.querySelectorAll("tr"));

                // keep "No records found" rows at bottom
                const emptyRow = rows.find(r => r.querySelector("td[colspan]"));
                const dataRows = rows.filter(r => r !== emptyRow);

                dataRows.sort((a, b) => {
                    const av = toComparable(getValue(a, key), type);
                    const bv = toComparable(getValue(b, key), type);

                    if (av < bv) return dir === "asc" ? -1 : 1;
                    if (av > bv) return dir === "asc" ? 1 : -1;
                    return 0;
                });

                tbody.innerHTML = "";
                dataRows.forEach(r => tbody.appendChild(r));
                if (emptyRow) tbody.appendChild(emptyRow);
            }

            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll("th.th-sort").forEach(th => {
                    th.addEventListener("click", () => sortTable(th));
                });
            });
        })();


    </script>
}


