<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - HRMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>

    <div class="app-container">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-logo">
                <img src="~/Icons/Logo.png" />
            </div>

            <ul class="sidebar-menu">
                <li class="menu-item">
                    <a asp-page="/Hrms/DailyLogs/DailyLogsUpload/Index">
                        <i class="bi bi-upload"></i>
                        <span>Daily Logs Upload</span>
                    </a>
                </li>

                <li class="menu-item">
                    <a asp-page="/Hrms/DailyLogs/ImportSummary/Index">
                        <i class="bi bi-clipboard-data"></i>
                        <span>Import Summary</span>
                    </a>
                </li>

                <li class="menu-item">
                    <a asp-page="/Hrms/DailyLogs/Preview/Index">
                        <i class="bi bi-eye"></i>
                        <span>Preview</span>
                    </a>
                </li>

                <li class="menu-item">
                    <a asp-page="/Hrms/DailyLogs/UploadHistory/Index">
                        <i class="bi bi-clock-history"></i>
                        <span>Upload History</span>
                    </a>
                </li>
            </ul>



            <div class="sidebar-footer">
                <i class="bi bi-person-circle"></i>
                <span>Supervisor</span>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            @RenderBody()
        </div>

    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
