@page "{id:int}"
@model HRMS_System.Pages.Hrms.EmployeeManagement.EditEmployeeInfoModel
@{
    ViewData["Title"] = "Edit Employee";
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<style>
    :root {
        --blue: #0B3D91;
        --bg: #F6F8FB;
        --text: #0F172A;
        --muted: #667085;
        --border: rgba(15, 23, 42, 0.12);
        --focus: rgba(11, 61, 145, 0.18);
        --shadow: 0 18px 50px rgba(2, 6, 23, 0.10);
    }

    html, body {
        height: 100%;
    }

    body {
        margin: 0;
        font-family: "Inter", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        color: var(--text);
        background: linear-gradient(180deg, #FFFFFF 0%, var(--bg) 100%);
    }

    .editemp-shell {
        min-height: 100vh;
        padding: 18px 18px 90px;
    }

    .editemp-card {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .editemp-head {
        padding: 18px 22px;
        border-bottom: 1px solid rgba(15,23,42,0.08);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        flex-wrap: wrap;
    }

    .editemp-title {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
    }

    .editemp-sub {
        margin: 6px 0 0;
        font-size: 13px;
        color: var(--muted);
    }

    .editemp-body {
        padding: 18px 22px 18px;
    }

    /* Labels + inputs */
    label {
        font-weight: 700;
        font-size: 12px;
        color: #344054;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid rgba(15,23,42,0.14);
        padding: 12px 12px;
        font-size: 14px;
        outline: none;
    }

        .form-control:focus, .form-select:focus {
            border-color: rgba(11,61,145,0.45);
            box-shadow: 0 0 0 4px var(--focus);
        }

    input[readonly] {
        background: rgba(11,61,145,.06);
        border-color: rgba(11,61,145,.28);
        font-weight: 800;
        color: var(--blue);
    }

    h6 {
        font-weight: 900;
        color: #344054;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid rgba(15,23,42,.08);
    }

    /* Profile image row */
    .editemp-avatar {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        padding: 12px;
        border: 1px solid rgba(15,23,42,0.10);
        border-radius: 14px;
        background: rgba(11,61,145,0.03);
    }

        .editemp-avatar img {
            width: 84px;
            height: 84px;
            object-fit: cover;
            border-radius: 999px;
            border: 2px solid rgba(11,61,145,0.18);
            background: #fff;
        }

    .editemp-hint {
        font-size: 12px;
        color: var(--muted);
        margin-top: 6px;
    }

    /* Sticky action bar */
    .editemp-actions {
        position: sticky;
        bottom: 0;
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(6px);
        border-top: 1px solid rgba(15,23,42,.08);
        padding: 12px 22px;
        margin: 18px -22px -18px;
        display: flex;
        gap: 12px;
    }

    .editemp-btn-primary {
        flex: 1;
        border: 0;
        cursor: pointer;
        border-radius: 10px;
        padding: 12px 14px;
        font-weight: 800;
        font-size: 14px;
        color: #fff;
        background: var(--blue);
        box-shadow: 0 12px 26px rgba(11,61,145,.18);
        transition: transform .12s ease, background .12s ease;
    }

        .editemp-btn-primary:hover {
            background: #08357E;
            transform: translateY(-1px);
        }

        .editemp-btn-primary:active {
            transform: translateY(0px);
        }

    .editemp-btn-ghost {
        flex: 1;
        border-radius: 10px;
        padding: 12px 14px;
        font-weight: 800;
        font-size: 14px;
        background: #fff;
        border: 1px solid rgba(15,23,42,0.14);
        color: #344054;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .editemp-btn-ghost:hover {
            background: #f8fafc;
        }

    /* Select2 match */
    .select2-container {
        width: 100% !important;
    }

        .select2-container .select2-selection--single {
            height: 44px !important;
            border-radius: 10px !important;
            border: 1px solid rgba(15,23,42,0.14) !important;
            padding: 8px 10px !important;
            display: flex !important;
            align-items: center !important;
        }

    /* Modal tune (same theme) */
    .modal-content {
        border-radius: 14px;
        border: 1px solid rgba(15,23,42,0.12);
        box-shadow: var(--shadow);
    }

    .modal-header {
        border-bottom: 1px solid rgba(15,23,42,0.08);
    }

    .modal-footer {
        border-top: 1px solid rgba(15,23,42,0.08);
    }
</style>

<script>
    function previewProfileImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById("profilePreview").src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

<div class="editemp-shell">
    <div class="editemp-card">

        <div class="editemp-head">
            <div>
                <h3 class="editemp-title">Edit Employee</h3>
                <p class="editemp-sub">Update employee details. Changes will be saved after confirmation.</p>
            </div>
        </div>

        <div class="editemp-body">

            <form method="post" id="editEmployeeForm" enctype="multipart/form-data" novalidate>

                <input type="hidden" asp-for="Employee.EmployeeNumber" />
                <input type="hidden" asp-for="Employee.Id" />

                <div asp-validation-summary="All" class="text-danger" style="font-size:12px;"></div>
                <!-- PROFILE IMAGE -->
                <div class="mb-4">
                    <label class="form-label">Profile Image (Optional)</label>

                    <div class="editemp-avatar">
                        <img id="profilePreview"
                             src="@(string.IsNullOrEmpty(Model.Employee.ProfileImagePath)
                                                          ? "/images/default-avatar.png" : Model.Employee.ProfileImagePath)" />

                        <div style="min-width: 260px; flex:1;">
                            <input type="file"
                                   asp-for="ProfileImage"
                                   accept="image/*"
                                   class="form-control"
                                   onchange="previewProfileImage(this)" />
                            <div class="editemp-hint">JPG / PNG, max 2MB</div>
                        </div>
                    </div>
                </div>

                <!-- EMPLOYEE NUMBER (display only) -->
                <div class="mb-3">
                    <label class="form-label">Employee Number</label>
                    <input id="EmployeeNumberPreview" class="form-control" value="@Model.Employee.EmployeeNumber" readonly />
                </div>

                <!-- NAME -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.FirstName"></label>
                        <input asp-for="Employee.FirstName" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.MiddleName"></label>
                        <input asp-for="Employee.MiddleName" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.LastName"></label>
                        <input asp-for="Employee.LastName" class="form-control" />
                    </div>
                </div>

                <!-- EMAIL & PHONE -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Employee.Email"></label>
                        <input asp-for="Employee.Email" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Employee.PhoneNumber"></label>
                        <input asp-for="Employee.PhoneNumber" class="form-control" />
                    </div>
                </div>

                <!-- PERSONAL INFO -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.BirthDate"></label>
                        <input asp-for="Employee.BirthDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.Gender"></label>
                        <select asp-for="Employee.Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                        <span asp-validation-for="Employee.Gender" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.CivilStatus"></label>
                        <select asp-for="Employee.CivilStatus" class="form-select">
                            <option value="">-- Select Status --</option>
                            <option>Single</option>
                            <option>Married</option>
                            <option>Widowed</option>
                        </select>
                        <span asp-validation-for="Employee.CivilStatus" class="text-danger"></span>
                    </div>
                </div>

                <!-- WORK INFORMATION -->
                <h6 class="mt-3">Working Information</h6>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.JobRole"></label>
                        <select asp-for="Employee.JobRole"
                                class="form-select"
                                id="JobRole"
                                asp-items="Model.JobRoleOptions">
                        </select>
                        <span asp-validation-for="Employee.JobRole" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.DepartmentId" class="form-label">Department</label>
                        <select asp-for="Employee.DepartmentId"
                                asp-items="Model.DepartmentOptions"
                                class="form-select"
                                id="DepartmentId">
                        </select>
                        <span asp-validation-for="Employee.DepartmentId" class="text-danger"></span>

                        <div class="mt-2" id="newDeptWrap" style="display:none;">
                            <label class="form-label">New Department Name</label>
                            <input asp-for="NewDepartmentName" class="form-control" />
                            <span asp-validation-for="NewDepartmentName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Employee.StartDate"></label>
                        <input asp-for="Employee.StartDate" type="date" class="form-control" />
                    </div>
                </div>

                <!-- STATUS -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Employee.EmploymentStatus"></label>
                        <select asp-for="Employee.EmploymentStatus" class="form-select">
                            <option value="">-- Select Status --</option>
                            <option>Regular</option>
                            <option>Probationary</option>
                        </select>
                        <span asp-validation-for="Employee.EmploymentStatus" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Employee.Status"></label>
                        <select asp-for="Employee.Status" class="form-select">
                            <option>Active</option>
                            <option>Inactive</option>
                        </select>
                    </div>
                </div>

                <!-- TENURE -->
                <div class="mb-3">
                    <label class="form-label">Tenure</label>
                    <input type="text"
                           class="form-control"
                           value="@(Model.Employee.TenureMonths.HasValue
                                                                     ? Model.Employee.TenureMonths + " months"
                                                                     : "Auto-calculated")"
                           readonly />
                </div>

                <!-- ADDRESS -->
                <div class="mb-3">
                    <label asp-for="Employee.Address"></label>
                    <input asp-for="Employee.Address" class="form-control" />
                </div>

                <!-- Sticky buttons -->
                <div class="editemp-actions">
                    <button type="button"
                            class="editemp-btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#confirmUpdateModal">
                        Save Changes
                    </button>

                    <a asp-page="/Hrms/EmployeeManagement/Index" class="editemp-btn-ghost">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- CONFIRM UPDATE MODAL -->
<div class="modal fade"
     id="confirmUpdateModal"
     tabindex="-1"
     aria-labelledby="confirmUpdateModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="confirmUpdateModalLabel">Confirm Employee Update</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>Are you sure you want to save the changes for this employee?</p>
                <p class="text-muted mb-0">This will permanently update the employee record.</p>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-primary" form="editEmployeeForm">
                    Yes, Update
                </button>

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
            </div>

        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deptSelect = document.getElementById("DepartmentId");
        const wrap = document.getElementById("newDeptWrap");
        const addNewValue = "@HRMS_System.Services.DepartmentSelectService.AddNewValue";

        function toggle() {
            wrap.style.display = (deptSelect.value === addNewValue) ? "block" : "none";
        }

        deptSelect.addEventListener("change", toggle);
        toggle();
    });

    $(document).ready(function () {
        const $jobRole = $('#JobRole');
        const employeeId = document.getElementById("Employee_Id").value;
        const previewInput = document.getElementById("EmployeeNumberPreview");
        const hiddenInput = document.getElementById("Employee_EmployeeNumber");

        $jobRole.select2({
            width: '100%',
            dropdownParent: $('body')
        });

        async function refreshEmployeeNumberPreview() {
            const jobRole = $jobRole.val();

            if (!jobRole || !employeeId) {
                return;
            }

            try {
                const url = `?handler=PreviewEmployeeNumber&jobRole=${encodeURIComponent(jobRole)}&employeeId=${encodeURIComponent(employeeId)}`;
                const res = await fetch(url);

                if (!res.ok) return;

                const data = await res.json();

                if (data.employeeNumber) {
                    previewInput.value = data.employeeNumber;
                    hiddenInput.value = data.employeeNumber;
                }
            } catch (err) {
                console.error("Failed to preview employee number:", err);
            }
        }

        $jobRole.on('change', refreshEmployeeNumberPreview);
    });
</script>