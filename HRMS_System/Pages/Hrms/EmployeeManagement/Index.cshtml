@page
@model HRMS_System.Pages.Hrms.EmployeeManagement.EmployeeManagementModel
@{
    ViewData["Title"] = "Employee Management";
    Layout = "/Pages/Hrms/_HRNavigationLayout.cshtml";
}
@* <a asp-page="/Account/LogoutPage" class="log-out-label" style="color:black;text-decoration:none;"><h5 class="log-out-label">Log out</h5></a>*@
 <div class="dashboard-page">
    <h1 class="page-title">Employee Management</h1>
    <div class="title-line"></div>
    <div class="records-header">
        <div>Employee Records</div>
        <a asp-page="/Hrms/EmployeeManagement/AddEmployee" class="button-43">
            Add New Employee
        </a>
    </div>

    <div class="input-group mb-3 hrms-toolbar">
        <input type="text"
               id="searchInput"
               class="form-control"
               placeholder="Search Employee (ID, name, email...)"
               aria-label="Search Employee" />
        <button class="btn-hrms btn-hrms-ghost" type="button" onclick="searchBtn()">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
    <br />
    <div class="records-box">
        <table class="table-fixed">
            <thead>
                <tr>
                    <th class="th-sort" data-sort="id" data-type="string">
                        EMP No. <span class="sort-icon"></span>
                    </th>
                    <th class="th-sort" data-sort="name" data-type="string">
                        Name <span class="sort-icon"></span>
                    </th>
                    <th class="th-sort" data-sort="phone" data-type="string">
                        Phone <span class="sort-icon"></span>
                    </th>
                    <th class="th-sort" data-sort="email" data-type="string">
                        Email <span class="sort-icon"></span>
                    </th>
                    <th style="width: 80px;"></th>
                </tr>
            </thead>

<tbody>
@if (Model.employeeInfo == null || !Model.employeeInfo.Any())
{
    <tr>
        <td colspan="5" class="text-center text-muted py-4">
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <span>No employees records found for "<strong>@Model.SearchTerm</strong>".</span>
            }
            else
            {
                <span>No employee records found.</span>
            }
        </td>
    </tr>
}
else
{
    @foreach (var emp in Model.employeeInfo)
    {
        <tr>
            <td>@emp.EmployeeNumber</td>
            <td>@emp.FirstName @emp.LastName</td>
            <td>@emp.PhoneNumber</td>
            <td>@emp.Email</td>
            <td style="position: relative; text-align: center;">
                <i class="bi bi-three-dots-vertical table-options"></i>
                <div class="table-dropdown">
                                    <a href="javascript:void(0)" onclick="openProfile(@emp.Id)">View</a>
                    <a asp-page="/Hrms/EmployeeManagement/EditEmployeeInformation"
                                       asp-route-id="@emp.Id">
                        Edit
                    </a>
                </div>
            </td>
        </tr>
    }
}
</tbody>

        </table>
    </div>
</div>

<!-- Overlay -->
<div id="overlay" onclick="closeProfile()"></div>

<!-- Profile Panel -->
<div id="profilePanel" class="profile-panel">

    <!-- Header -->
    <div class="pp-head">
        <button type="button" class="pp-back" onclick="closeProfile()" aria-label="Back">
            <i class="bi bi-arrow-left"></i>
        </button>

        <div class="pp-top">
            <img id="empAvatar" class="pp-avatar" src="/Icons/default-avatar.png" alt="Employee" />

            <div class="pp-title">
                <div id="empName" class="pp-name">—</div>

                <div class="pp-stats">
                    <div class="pp-stat">
                        <div class="pp-stat-label">Status</div>
                        <div id="empStatus" class="pp-stat-value status-active">—</div>
                    </div>

                    <div class="pp-stat">
                        <div class="pp-stat-label">Start Date</div>
                        <div id="empStartDate" class="pp-stat-value">—</div>
                    </div>

                    <div class="pp-stat">
                        <div class="pp-stat-label">Tenure</div>
                        <div id="empTenure" class="pp-stat-value">—</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Body -->
    <div class="pp-body">

        <div class="pp-section">
            <h4 class="pp-section-title">Working Information</h4>

            <div class="pp-list">
                <div class="pp-item">
                    <i class="bi bi-credit-card pp-ico"></i>
                    <div class="pp-label">ID No.</div>
                    <div id="empId" class="pp-value">—</div>
                </div>

                <div class="pp-item">
                    <i class="bi bi-briefcase pp-ico"></i>
                    <div class="pp-label">Job Role</div>
                    <div id="empJobRole" class="pp-value">—</div>
                </div>

                <div class="pp-item">
                    <i class="bi bi-diagram-3 pp-ico"></i>
                    <div class="pp-label">Department</div>
                    <div id="empDepartment" class="pp-value">—</div>
                </div>

                <div class="pp-item">
                    <i class="bi bi-person-badge pp-ico"></i>
                    <div class="pp-label">Emp Status</div>
                    <div id="empType" class="pp-value">—</div>
                </div>
            </div>
        </div>

        <div class="pp-section">
            <h4 class="pp-section-title">Personal Information</h4>

            <div class="pp-list">
                <div class="pp-item">
                    <i class="bi bi-gender-female pp-ico"></i>
                    <div class="pp-label">Gender</div>
                    <div id="empGender" class="pp-value">—</div>
                </div>

                <div class="pp-item">
                    <i class="bi bi-heart pp-ico"></i>
                    <div class="pp-label">Civil Status</div>
                    <div id="empCivil" class="pp-value">—</div>
                </div>

                <div class="pp-item">
                    <i class="bi bi-envelope pp-ico"></i>
                    <div class="pp-label">Email</div>
                    <div id="empEmail" class="pp-value">—</div>
                </div>

                <div class="pp-item">
                    <i class="bi bi-telephone pp-ico"></i>
                    <div class="pp-label">Phone</div>
                    <div id="empPhone" class="pp-value">—</div>
                </div>

                <div class="pp-item">
                    <i class="bi bi-geo-alt pp-ico"></i>
                    <div class="pp-label">Address</div>
                    <div id="empAddress" class="pp-value">—</div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".table-options").forEach(icon => {
            icon.addEventListener("click", function (e) {
                e.stopPropagation();
                const dropdown = this.nextElementSibling;
                if (!dropdown) return;

                document.querySelectorAll(".table-dropdown").forEach(d => {
                    if (d !== dropdown) d.classList.remove("show");
                });

                dropdown.classList.toggle("show");
            });
        });

        document.addEventListener("click", function () {
            document.querySelectorAll(".table-dropdown").forEach(d => d.classList.remove("show"));
        });
    });

    function openProfile(empId) {
        fetch(`/Hrms/EmployeeManagement?handler=EmployeeProfile&id=${empId}`)
            .then(res => res.json())
            .then(emp => {

                document.getElementById("empAvatar").src =
                    emp.profileImagePath || "/Icons/default-avatar.png";

                document.getElementById("empName").innerText = emp.fullName;
                document.getElementById("empStatus").innerText = emp.status;
                document.getElementById("empStatus").className = emp.status === "Active"? "status-active" : "status-inactive";
                document.getElementById("empStartDate").innerText = new Date(emp.startDate).toLocaleDateString();

                    // Tenure (computed from startDate)
                if (emp.startDate) {
                    const start = new Date(emp.startDate);
                    const today = new Date();
                    let months = (today.getFullYear() - start.getFullYear()) * 12 + (today.getMonth() - start.getMonth());
                    if (today.getDate() < start.getDate()) months--; // adjust if not completed month
                    if (months < 0) months = 0;

                    document.getElementById("empTenure").innerText = months === 1 ? "1 month" : `${months} months`;
                } else {
                    document.getElementById("empTenure").innerText = "-";
                }
                const idNumOnly = emp.idNumber?.split('-')[1] || "";
                document.getElementById("empId").innerText = emp.idNumber;
                document.getElementById("empJobRole").innerText = emp.jobRole;
                document.getElementById("empDepartment").innerText = emp.department;
                document.getElementById("empType").innerText = emp.employeeType;
                document.getElementById("empGender").innerText = emp.gender;
                document.getElementById("empCivil").innerText = emp.civilStatus;
                document.getElementById("empEmail").innerText = emp.email;
                document.getElementById("empPhone").innerText = emp.phoneNumber;
                document.getElementById("empAddress").innerText = emp.address;
                document.getElementById("profilePanel").classList.add("active");
                document.getElementById("overlay").classList.add("active");
            });
    }

    function closeProfile() {
        document.getElementById("profilePanel").classList.remove("active");
        document.getElementById("overlay").classList.remove("active");
    }

    function searchBtn() {
        const value = document.getElementById("searchInput").value.trim();
        const url = new URL(window.location.href);

        if (value) url.searchParams.set("SearchTerm", value);
        else url.searchParams.delete("SearchTerm");

        window.location.href = url.toString();
    }

    document.getElementById("searchInput").addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            searchBtn();
        }
    });

        (function () {

        function toComparable(text, type) {
            const v = (text ?? "").toString().trim();

            if (type === "number") {
                const n = parseInt(v.replace(/[^\d\-]/g, ""), 10);
                return Number.isFinite(n) ? n : -1;
            }

            return v.toLowerCase(); // string
        }

        function getValue(row, key) {
            const tds = row.querySelectorAll("td");
            if (!tds.length) return "";

            // Employee Management table columns:
            // 0 = ID, 1 = Name, 2 = Phone, 3 = Email, 4 = menu
            switch (key) {
                case "id": return tds[0]?.innerText ?? "";
                case "name": return tds[1]?.innerText ?? "";
                case "phone": return tds[2]?.innerText ?? "";
                case "email": return tds[3]?.innerText ?? "";
            }
            return "";
        }

        function sortTable(th) {
            const table = th.closest("table");
            const tbody = table?.querySelector("tbody");
            if (!table || !tbody) return;

            const key = th.dataset.sort;
            const type = th.dataset.type || "string";

            // toggle direction
            const current = th.getAttribute("data-dir") || "none";
            const dir = current === "asc" ? "desc" : "asc";
            th.setAttribute("data-dir", dir);

            // reset other headers in same table
            table.querySelectorAll("th.th-sort").forEach(h => {
                if (h !== th) h.setAttribute("data-dir", "none");
            });

            const rows = Array.from(tbody.querySelectorAll("tr"));

            // keep "no records" row at bottom
            const emptyRow = rows.find(r => r.querySelector("td[colspan]"));
            const dataRows = rows.filter(r => r !== emptyRow);

            dataRows.sort((a, b) => {
                const av = toComparable(getValue(a, key), type);
                const bv = toComparable(getValue(b, key), type);

                if (av < bv) return dir === "asc" ? -1 : 1;
                if (av > bv) return dir === "asc" ? 1 : -1;
                return 0;
            });

            tbody.innerHTML = "";
            dataRows.forEach(r => tbody.appendChild(r));
            if (emptyRow) tbody.appendChild(emptyRow);
        }

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("th.th-sort").forEach(th => {
                th.addEventListener("click", (e) => {
                    // prevent any accidental selection highlight
                    e.preventDefault();
                    sortTable(th);
                });
            });
        });

    })();
</script>
