@page
@model HRMS_System.Pages.Hrms.EmployeeManagement.AddEmployeeModel
@{
    ViewData["Title"] = "Add New Employee";
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<div class="container mt-4">
    <h3 class="mb-3">Add New Employee</h3>
    <hr />

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- ID NUMBER -->
        <div class="mb-3">
            <label asp-for="Employee.EmployeeNumber" class="form-label"></label>
            <input asp-for="Employee.EmployeeNumber" class="form-control" readonly />
            <span asp-validation-for="Employee.EmployeeNumber" class="text-danger"></span>
        </div>

        <!-- NAME -->
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Employee.FirstName"></label>
                <input asp-for="Employee.FirstName" class="form-control" />
                <span asp-validation-for="Employee.FirstName" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Employee.MiddleName"></label>
                <input asp-for="Employee.MiddleName" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Employee.LastName"></label>
                <input asp-for="Employee.LastName" class="form-control" />
                <span asp-validation-for="Employee.LastName" class="text-danger"></span>
            </div>
        </div>

        <!-- EMAIL & PHONE -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Employee.Email"></label>
                <input asp-for="Employee.Email" class="form-control" placeholder="example@gmail.com" />
                <span asp-validation-for="Employee.Email" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Employee.PhoneNumber"></label>
                <input asp-for="Employee.PhoneNumber" class="form-control" />
                <span asp-validation-for="Employee.PhoneNumber" class="text-danger"></span>
            </div>
        </div>

        <!-- PERSONAL INFO -->
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Employee.BirthDate"></label>
                <input asp-for="Employee.BirthDate" type="date" class="form-control" />
                <span asp-validation-for="Employee.BirthDate" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Employee.Gender"></label>
                <select asp-for="Employee.Gender" class="form-control">
                    <option value="">-- Select Gender --</option>
                    <option>Male</option>
                    <option>Female</option>
                </select>
                <span asp-validation-for="Employee.Gender" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Employee.CivilStatus"></label>
                <select asp-for="Employee.CivilStatus" class="form-control">
                    <option value="">-- Select Status --</option>
                    <option>Single</option>
                    <option>Married</option>
                    <option>Widowed</option>
                </select>
                <span asp-validation-for="Employee.CivilStatus" class="text-danger"></span>
            </div>
        </div>

        <!-- WORK INFORMATION -->
        <h6 class="mt-3">Working Information</h6>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Employee.JobRole"></label>
                <select asp-for="Employee.JobRole" class="form-control" id="JobRole">
                    <option value="">-- Select Job Role --</option>

                    <optgroup label="Operations / Port Operations">
                        <option value="Port Worker">Port Worker</option>
                        <option value="Extra Port Worker">Extra Port Worker</option>
                        <option value="Port Worker / RTG">Port Worker / RTG</option>
                        <option value="Port Worker / Timekeeper">Port Worker / Timekeeper</option>
                        <option value="Gantry Operator">Gantry Operator</option>
                        <option value="Quay Crane Operator">Quay Crane Operator</option>
                        <option value="QC Crane Operator">QC Crane Operator</option>
                        <option value="RTG Operator">RTG Operator</option>
                        <option value="RTG Trainee">RTG Trainee</option>
                        <option value="Reach Stacker Operator">Reach Stacker Operator</option>
                        <option value="Prime Mover Operator">Prime Mover Operator</option>
                        <option value="Extra Prime Mover">Extra Prime Mover</option>
                        <option value="PM Operator">PM Operator</option>
                        <option value="Transtrainer Operator">Transtrainer Operator</option>
                        <option value="Sidelifter Operator">Sidelifter Operator</option>
                        <option value="Forklift Operator">Forklift Operator</option>
                        <option value="Winchman">Winchman</option>
                        <option value="Winchman – Pooling">Winchman – Pooling</option>
                        <option value="Gang Boss">Gang Boss</option>
                        <option value="Foreman">Foreman</option>
                        <option value="Gear Locker">Gear Locker</option>
                        <option value="Gatekeeper">Gatekeeper</option>
                        <option value="Gate Control Checker">Gate Control Checker</option>
                        <option value="Assigning Checker">Assigning Checker</option>
                        <option value="CY Checker">CY Checker</option>
                        <option value="Dock Checker">Dock Checker</option>
                        <option value="Document Verifier">Document Verifier</option>
                        <option value="Checker">Checker</option>
                        <option value="Tireman">Tireman</option>
                    </optgroup>

                    <optgroup label="Technical / Engineering / Maintenance">
                        <option value="Mechanic">Mechanic</option>
                        <option value="Senior Mechanic">Senior Mechanic</option>
                        <option value="Junior Mechanic">Junior Mechanic</option>
                        <option value="Heavy Equipment Mechanic">Heavy Equipment Mechanic</option>
                        <option value="Junior Heavy Equipment Mechanic">Junior Heavy Equipment Mechanic</option>
                        <option value="Senior Heavy Equipment Mechanic">Senior Heavy Equipment Mechanic</option>
                        <option value="Bulk Handling Mechanic">Bulk Handling Mechanic</option>
                        <option value="Industrial Electrician">Industrial Electrician</option>
                        <option value="Junior Industrial Electrician">Junior Industrial Electrician</option>
                        <option value="Automotive Electrician">Automotive Electrician</option>
                        <option value="Electronics Technician">Electronics Technician</option>
                        <option value="Junior Electronics Technician">Junior Electronics Technician</option>
                        <option value="Assistant Electronics Technician">Assistant Electronics Technician</option>
                        <option value="Reefer Container Technician">Reefer Container Technician</option>
                        <option value="Reefer Monitoring Technician">Reefer Monitoring Technician</option>
                        <option value="Welder">Welder</option>
                        <option value="Industrial Welder">Industrial Welder</option>
                        <option value="Carpenter">Carpenter</option>
                        <option value="Painter">Painter</option>
                        <option value="Sewer">Sewer</option>
                        <option value="Toolkeeper">Toolkeeper</option>
                        <option value="Maintenance Utility">Maintenance Utility</option>
                        <option value="Technical &amp; Maintenance Staff">Technical &amp; Maintenance Staff</option>
                    </optgroup>

                    <optgroup label="Administrative / Office">
                        <option value="Office Staff">Office Staff</option>
                        <option value="Office Assistant to the OM">Office Assistant to the OM</option>
                        <option value="Record Keeper">Record Keeper</option>
                        <option value="Timekeeper">Timekeeper</option>
                        <option value="Head Timekeeper">Head Timekeeper</option>
                        <option value="Payroll Clerk">Payroll Clerk</option>
                        <option value="Billing Clerk">Billing Clerk</option>
                        <option value="Billing Staff">Billing Staff</option>
                        <option value="Accounting Staff">Accounting Staff</option>
                        <option value="Subsidiary Ledger Clerk">Subsidiary Ledger Clerk</option>
                        <option value="Subsidiary Ledger In-Charge">Subsidiary Ledger In-Charge</option>
                        <option value="Credit &amp; Collection Staff">Credit &amp; Collection Staff</option>
                        <option value="Purchasing Clerk">Purchasing Clerk</option>
                        <option value="HR Clerk">HR Clerk</option>
                        <option value="HR Staff">HR Staff</option>
                        <option value="Paymaster">Paymaster</option>
                        <option value="Audit Staff">Audit Staff</option>
                    </optgroup>

                    <optgroup label="IT / MIS / Systems">
                        <option value="MIS Staff">MIS Staff</option>
                        <option value="MIS Programmer">MIS Programmer</option>
                        <option value="Junior MIS Programmer">Junior MIS Programmer</option>
                        <option value="IT Development Personnel">IT Development Personnel</option>
                        <option value="Junior Technical Specialist">Junior Technical Specialist</option>
                        <option value="MIS Junior Technical Specialist">MIS Junior Technical Specialist</option>
                    </optgroup>

                    <optgroup label="Drivers / Transport">
                        <option value="Service Driver">Service Driver</option>
                        <option value="Shuttle Driver">Shuttle Driver</option>
                        <option value="Executive Driver">Executive Driver</option>
                        <option value="Ambulance Driver">Ambulance Driver</option>
                    </optgroup>

                    <optgroup label="Safety / Medical / Security">
                        <option value="Company Nurse">Company Nurse</option>
                        <option value="First Aider">First Aider</option>
                        <option value="Safety Officer">Safety Officer</option>
                        <option value="Security Aide">Security Aide</option>
                        <option value="SSHEMO Staff">SSHEMO Staff</option>
                        <option value="Assistant Pollution Control Officer">Assistant Pollution Control Officer</option>
                    </optgroup>

                    <optgroup label="Logistics / Warehouse / Support">
                        <option value="Warehouse Staff">Warehouse Staff</option>
                        <option value="Warehouse Clerk">Warehouse Clerk</option>
                        <option value="CFS Staff">CFS Staff</option>
                        <option value="ISO Staff">ISO Staff</option>
                        <option value="Utility Personnel">Utility Personnel</option>
                        <option value="General Services Utility">General Services Utility</option>
                        <option value="General Services Driver">General Services Driver</option>
                        <option value="General Services Painter">General Services Painter</option>
                        <option value="General Services Carpenter">General Services Carpenter</option>
                    </optgroup>

                    <optgroup label="Finance / Claims / Insurance">
                        <option value="Insurance &amp; Claims Staff">Insurance &amp; Claims Staff</option>
                        <option value="Insurance &amp; Claims In-Charge">Insurance &amp; Claims In-Charge</option>
                    </optgroup>

                    <optgroup label="Misc / Support Roles">
                        <option value="Cashier">Cashier</option>
                        <option value="Satellite Cashier">Satellite Cashier</option>
                        <option value="Augmentation Cashier">Augmentation Cashier</option>
                        <option value="Extra">Extra</option>
                        <option value="Operations Staff">Operations Staff</option>
                        <option value="Operations &amp; Monitoring Staff">Operations &amp; Monitoring Staff</option>
                        <option value="OPN / Monitoring Staff">OPN / Monitoring Staff</option>
                        <option value="VOS">VOS</option>
                    </optgroup>
                </select>
                <span asp-validation-for="Employee.JobRole" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Employee.Department"></label>
                <select id="Department" name="Employee.Department" class="form-control">
                    <option value="">-- Select Department --</option>
                    <option value="Chairman's Office">Chairman's Office</option>
                    <option value="Vice Chairman's Office">Vice Chairman's Office</option>
                    <option value="Administration">Administration</option>
                    <option value="Engineering">Engineering</option>
                    <option value="Finance">Finance</option>
                    <option value="Finance">General Manager</option>
                    <option value="Legal">Legal</option>
                </select>
                <span asp-validation-for="Employee.Department" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Employee.StartDate"></label>
                <input asp-for="Employee.StartDate" type="date" class="form-control" />
                <span asp-validation-for="Employee.StartDate" class="text-danger"></span>
            </div>
        </div>

        <!-- STATUS -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Employee.EmploymentStatus"></label>
                <select asp-for="Employee.EmploymentStatus" class="form-control">
                    <option value="">-- Select Employment Status --</option>
                    <option>Regular</option>
                    <option>Probationary</option>
                </select>
                <span asp-validation-for="Employee.EmploymentStatus" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Employee.Status"></label>
                <select asp-for="Employee.Status" class="form-control">
                    <option>Active</option>
                    <option>Inactive</option>
                </select>
                <span asp-validation-for="Employee.Status" class="text-danger"></span>
            </div>
        </div>

        <!-- ADDRESS -->
        <div class="mb-3">
            <label asp-for="Employee.Address"></label>
            <input asp-for="Employee.Address" class="form-control" />
            <span asp-validation-for="Employee.Address" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Employee
        </button>
        <a asp-page="/Hrms/EmployeeManagement/index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#JobRole').select2({
                width: '100%',
                dropdownParent: $('.container')
            });
        });
    </script>
}
