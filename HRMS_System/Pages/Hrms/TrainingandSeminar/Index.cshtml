@page
@model HRMS_System.Pages.Hrms.TrainingandSeminar.IndexModel
@{
    ViewData["Title"] = "Training and Seminar";
    Layout = "/Pages/Hrms/_HRNavigationLayout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard-shared.css" />

<style>
    .ts-page {
        padding: 14px 0 24px;
    }

    .ts-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .ts-title-wrap {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .ts-title {
        font-size: 30px;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .ts-subtitle {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .ts-section-title {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: #1f2937;
    }

    .ts-section-subtitle {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .ts-card {
        background: #fff;
        border: 1px solid #dbe3ef;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
        padding: 22px;
    }

    .ts-summary-card {
        margin-bottom: 18px;
    }

    .ts-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .ts-search-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .ts-search-input {
        min-width: 290px;
        height: 42px;
        padding: 0 14px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        outline: none;
        font-size: 14px;
        transition: 0.2s ease;
    }

        .ts-search-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }

    .ts-btn {
        height: 42px;
        border: none;
        border-radius: 12px;
        padding: 0 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
    }

    .ts-btn-primary {
        background: #2563eb;
        color: #fff;
    }

        .ts-btn-primary:hover {
            background: #1d4ed8;
        }

    .ts-btn-secondary {
        background: #eef2ff;
        color: #1e3a8a;
        border: 1px solid #c7d2fe;
    }

        .ts-btn-secondary:hover {
            background: #e0e7ff;
        }

    .ts-btn-light {
        background: #f8fafc;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

        .ts-btn-light:hover {
            background: #f1f5f9;
        }

    .ts-table-wrap {
        overflow-x: auto;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
    }

    .ts-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
        background: #fff;
    }

        .ts-table thead th {
            background: #f8fafc;
            color: #334155;
            font-size: 13px;
            font-weight: 700;
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid #e5e7eb;
        }

        .ts-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #eef2f7;
            font-size: 14px;
            color: #1f2937;
            vertical-align: middle;
        }

        .ts-table tbody tr:hover {
            background: #f9fbff;
        }

    .ts-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .ts-action-btn {
        border: 1px solid #dbe3ef;
        background: #fff;
        color: #334155;
        border-radius: 10px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .ts-action-btn:hover {
            background: #f8fafc;
        }

        .ts-action-btn.edit {
            color: #1d4ed8;
            border-color: #bfdbfe;
            background: #eff6ff;
        }

            .ts-action-btn.edit:hover {
                background: #dbeafe;
            }

        .ts-action-btn.delete {
            color: #b91c1c;
            border-color: #fecaca;
            background: #fef2f2;
        }

            .ts-action-btn.delete:hover {
                background: #fee2e2;
            }

    .ts-empty {
        text-align: center;
        padding: 36px 20px;
        color: #6b7280;
    }

    .ts-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 5px 10px;
        border-radius: 999px;
        background: #ecfeff;
        color: #155e75;
        font-weight: 700;
        font-size: 12px;
    }

    .validation-summary-errors,
    .field-validation-error {
        color: #b91c1c;
        font-size: 13px;
    }

    /* Modal */
    .ts-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        padding: 20px;
    }

        .ts-modal-backdrop.show {
            display: flex;
        }

    .ts-modal {
        width: 100%;
        max-width: 720px;
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.22);
        overflow: hidden;
        animation: modalPop 0.18s ease-out;
    }

    @@keyframes modalPop {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .ts-modal-header {
        padding: 18px 22px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        border-bottom: 1px solid #dbe3ef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
    }

    .ts-modal-title {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .ts-close-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: none;
        background: #fff;
        font-size: 22px;
        cursor: pointer;
        color: #334155;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
    }

    .ts-modal-body {
        padding: 24px 22px 18px;
    }

    .ts-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .ts-form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .ts-form-group.full {
            grid-column: 1 / -1;
        }

    .ts-label {
        font-size: 14px;
        font-weight: 700;
        color: #374151;
    }

    .ts-input,
    .ts-select {
        width: 100%;
        height: 44px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 0 14px;
        font-size: 14px;
        outline: none;
        transition: 0.2s ease;
        background: #fff;
    }

        .ts-input:focus,
        .ts-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }

    .ts-modal-footer {
        padding: 18px 22px 22px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    @@media (max-width: 768px) {
        .ts-form-grid {
            grid-template-columns: 1fr;
        }

        .ts-search-input {
            min-width: 100%;
        }

        .ts-toolbar {
            align-items: stretch;
        }

        .ts-search-form {
            width: 100%;
        }
    }

    .ts-radio-group {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 2px;
    }

    .ts-radio-card {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 72px;
        height: 44px;
        padding: 0 18px;
        border: 1px solid #cbd5e1;
        border-radius: 14px;
        background: #fff;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 14px;
        font-weight: 700;
        color: #334155;
        user-select: none;
    }

        .ts-radio-card:hover {
            border-color: #94a3b8;
            background: #f8fafc;
        }

        .ts-radio-card input[type="radio"] {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .ts-radio-card span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .ts-radio-card input[type="radio"]:checked + span {
            color: #1d4ed8;
        }

        .ts-radio-card:has(input[type="radio"]:checked) {
            border-color: #2563eb;
            background: #eff6ff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }
</style>

<div class="ts-page">
    <div class="ts-header">
        <div class="ts-title-wrap">
            <h1 class="ts-title">Training & Seminar</h1>
            <p class="ts-subtitle">Manage employee seminar, training, and certificate records.</p>
        </div>

        <button type="button" class="ts-btn ts-btn-primary" onclick="openAddModal()">
            + Add New Record
        </button>
    </div>

