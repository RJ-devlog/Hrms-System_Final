    <div class="ts-card">
        <div class="ts-toolbar">
            <form method="get" class="ts-search-form">
                <input type="text"
                       name="SearchTerm"
                       value="@Model.SearchTerm"
                       class="ts-search-input"
                       placeholder="Search by title, employee name, or employee number..." />
                <button type="submit" class="ts-btn ts-btn-secondary">Search</button>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-page="./Index" class="ts-btn ts-btn-light">Clear</a>
                }
            </form>
        </div>

        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>Title / Certificate</th>
                        <th>Employee</th>
                        <th>Date Accomplished</th>
                        <th>Points</th>
                        <th style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Trainings != null && Model.Trainings.Any())
                    {
                        foreach (var item in Model.Trainings)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.EmployeeDisplay</td>
                                <td>@item.DateAccomplished.ToString("MMMM dd, yyyy")</td>
                                <td>
                                    <span class="ts-badge">@item.Points</span>
                                </td>
                                <td>
                                    <div class="ts-actions">
                                        <button type="button"
                                                class="ts-action-btn edit"
                                                onclick="openEditModal(this)"
                                                data-id="@item.Id"
                                                data-userid="@item.UserInformationId"
                                                data-title="@item.Title"
                                                data-date="@item.DateAccomplished.ToString("yyyy-MM-dd")"
                                                data-points="@item.Points">
                                            Edit
                                        </button>

                                        <form method="post" asp-page-handler="Delete" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit"
                                                    class="ts-action-btn delete"
                                                    onclick="return confirm('Delete this training/seminar record?');">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="ts-empty">
                                    No training or seminar records found.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="ts-modal-backdrop" id="trainingModal">
    <div class="ts-modal">
        <div class="ts-modal-header">
            <h2 class="ts-modal-title" id="modalTitle">Add Seminar / Training</h2>
            <button type="button" class="ts-close-btn" onclick="closeModal()">&times;</button>
        </div>

        <form method="post" asp-page-handler="Save">
            <div class="ts-modal-body">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <input asp-for="Input.Id" type="hidden" id="Input_Id" />

                <div class="ts-form-grid">
                    <div class="ts-form-group full">
                        <label asp-for="Input.Title" class="ts-label"></label>
                        <input asp-for="Input.Title" class="ts-input" id="Input_Title" />
                        <span asp-validation-for="Input.Title" class="field-validation-error"></span>
                    </div>

                    <div class="ts-form-group full">
                        <label asp-for="Input.UserInformationId" class="ts-label"></label>
                        <select asp-for="Input.UserInformationId"
                                asp-items="Model.EmployeeOptions"
                                class="ts-select"
                                id="Input_UserInformationId">
                            <option value="">-- Select Employee --</option>
                        </select>
                        <span asp-validation-for="Input.UserInformationId" class="field-validation-error"></span>
                    </div>

                    <div class="ts-form-group">
                        <label asp-for="Input.DateAccomplished" class="ts-label"></label>
                        <input asp-for="Input.DateAccomplished"
                               type="date"
                               class="ts-input"
                               id="Input_DateAccomplished" />
                        <span asp-validation-for="Input.DateAccomplished" class="field-validation-error"></span>
                    </div>

                    <div class="ts-form-group">
                        <label class="ts-label">Points</label>

                        <div class="ts-radio-group" id="pointsRadioGroup">
                            <label class="ts-radio-card">
                                <input asp-for="Input.Points" type="radio" value="2" />
                                <span>2</span>
                            </label>

                            <label class="ts-radio-card">
                                <input asp-for="Input.Points" type="radio" value="4" />
                                <span>4</span>
                            </label>

                            <label class="ts-radio-card">
                                <input asp-for="Input.Points" type="radio" value="6" />
                                <span>6</span>
                            </label>
                        </div>

                        <span asp-validation-for="Input.Points" class="field-validation-error"></span>
                    </div>
                </div>
            </div>

            <div class="ts-modal-footer">
                <button type="button" class="ts-btn ts-btn-light" onclick="closeModal()">Cancel</button>
                <button type="submit" class="ts-btn ts-btn-primary">Save Record</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const modal = document.getElementById('trainingModal');
        const modalTitle = document.getElementById('modalTitle');

        function getLocalToday() {
            const now = new Date();
            const local = new Date(now.getTime() - (now.getTimezoneOffset() * 60000));
            return local.toISOString().split('T')[0];
        }

        function openAddModal() {
            modalTitle.textContent = 'Add Seminar / Training';

            document.getElementById('Input_Id').value = '0';
            document.getElementById('Input_Title').value = '';
            document.getElementById('Input_UserInformationId').value = '';
            document.getElementById('Input_DateAccomplished').value = getLocalToday();
            setPointsRadio(2);

            modal.classList.add('show');
        }

        function openEditModal(button) {
            modalTitle.textContent = 'Edit Seminar / Training';

            document.getElementById('Input_Id').value = button.dataset.id || '0';
            document.getElementById('Input_UserInformationId').value = button.dataset.userid || '';
            document.getElementById('Input_Title').value = button.dataset.title || '';
            document.getElementById('Input_DateAccomplished').value = button.dataset.date || '';
            setPointsRadio(button.dataset.points || 2);

            modal.classList.add('show');
        }

        function closeModal() {
            modal.classList.remove('show');
        }

        function setPointsRadio(value) {
            const radios = document.querySelectorAll('#pointsRadioGroup input[type="radio"]');
            radios.forEach(radio => {
                radio.checked = radio.value === String(value);
            });
        }

        window.addEventListener('click', function (e) {
            if (e.target === modal) {
                closeModal();
            }
        });
    </script>
}