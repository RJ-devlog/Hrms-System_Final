@page
@model HRMS_System.Pages.Account.ChangePasswordModel
@{
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<style>
    :root {
        --blue: #0B3D91;
        --red: #C81E2A;
        --bg: #F6F8FB;
        --card: #FFFFFF;
        --text: #0F172A;
        --muted: #667085;
        --border: rgba(15, 23, 42, 0.12);
        --focus: rgba(11, 61, 145, 0.18);
        --shadow: 0 18px 50px rgba(2, 6, 23, 0.10);
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
    }

    body {
        margin: 0;
        font-family: "Inter", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        color: var(--text);
        background: linear-gradient(180deg, #FFFFFF 0%, var(--bg) 100%);
    }

    .login-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 28px 24px;
    }

    .brand-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 6px;
    }

    .brand-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-logo {
        width: 52px;
        height: 52px;
        object-fit: contain;
        border-radius: 12px;
        background: #fff;
        border: 1px solid var(--border);
        padding: 8px;
    }

    .brand-text .brand-name {
        font-weight: 700;
        font-size: 18px;
        color: var(--blue);
        line-height: 1.1;
    }

    .brand-text .brand-sub {
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
    }

    .brand-mark {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .brand-mark span {
            display: inline-block;
            width: 42px;
            height: 4px;
            border-radius: 999px;
        }

    .mark-blue {
        background: var(--blue);
    }

    .mark-red {
        background: var(--red);
    }

    .login-main {
        flex: 1;
        display: grid;
        place-items: center;
        padding: 14px 0 18px;
    }

    .login-card {
        width: min(460px, 92vw);
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 26px;
        box-shadow: var(--shadow);
    }

    .card-head {
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        text-align: center;
    }

    .card-title {
        margin: 0;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: -0.2px;
    }

    .card-sub {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 12px;
    }

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field-label {
        font-size: 12px;
        font-weight: 600;
        color: #344054;
    }

    .field-input {
        width: 100%;
        border-radius: 10px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        background: #fff;
        padding: 12px 12px;
        font-size: 14px;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .field-input:focus {
            border-color: rgba(11, 61, 145, 0.45);
            box-shadow: 0 0 0 4px var(--focus);
        }

    .field-validation {
        font-size: 12px;
    }

    .summary-wrap {
        font-size: 12px;
        margin-top: -2px;
    }

    .btn-login {
        margin-top: 4px;
        border: 0;
        cursor: pointer;
        border-radius: 10px;
        padding: 12px 14px;
        font-weight: 700;
        font-size: 14px;
        color: #fff;
        background: var(--blue);
        box-shadow: 0 12px 26px rgba(11,61,145,.18);
        transition: transform .12s ease, background .12s ease;
        width: 100%;
    }

        .btn-login:hover {
            background: #08357E;
            transform: translateY(-1px);
        }

        .btn-login:active {
            transform: translateY(0px);
        }

    .btn-ghost {
        margin-top: 8px;
        width: 100%;
        border-radius: 10px;
        padding: 12px 14px;
        font-weight: 700;
        font-size: 14px;
        background: #fff;
        border: 1px solid rgba(15, 23, 42, 0.14);
        color: #344054;
        cursor: pointer;
        transition: background .12s ease;
        text-align: center;
        text-decoration: none;
        display: inline-block;
    }

        .btn-ghost:hover {
            background: #f8fafc;
        }

    .footnote {
        margin-top: 8px;
        font-size: 12px;
        color: var(--muted);
        text-align: center;
    }

    .login-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        color: rgba(102,112,133,.95);
        font-size: 12px;
        padding-top: 6px;
    }

        .login-footer .sep {
            opacity: .7;
        }
</style>

<div class="login-shell">
    <header class="brand-bar">
        <div class="brand-left">
            <img class="brand-logo" src="/Icons/Logo.png" alt="HRMS" />
            <div class="brand-text">
                <span style="color:blue; font-weight:bold;">HR</span><span style="color:red;font-weight:bold;">MS</span>
                <div class="brand-sub">Human Resource Management System</div>
            </div>
        </div>

        <div class="brand-mark" aria-hidden="true">
            <span class="mark-blue"></span>
            <span class="mark-red"></span>
        </div>
    </header>

    <main class="login-main">
        <section class="login-card shadow-sm" aria-label="Change Password">
            <div class="card-head">
                <h1 class="card-title">Change Password</h1>
                <p class="card-sub">Enter your current password and set a new one.</p>
            </div>

            <form method="post" class="login-form" novalidate>
                <div class="form-field">
                    <label class="field-label" for="currentPw">Current Password</label>
                    <input id="currentPw" asp-for="Input.CurrentPassword" type="password" class="field-input" autocomplete="current-password" />
                    <span class="field-validation text-danger" asp-validation-for="Input.CurrentPassword"></span>
                </div>

                <div class="form-field">
                    <label class="field-label" for="newPw">New Password</label>
                    <input id="newPw" asp-for="Input.NewPassword" type="password" class="field-input" autocomplete="new-password" />
                    <span class="field-validation text-danger" asp-validation-for="Input.NewPassword"></span>
                </div>

                <div class="form-field">
                    <label class="field-label" for="confirmPw">Confirm New Password</label>
                    <input id="confirmPw" asp-for="Input.ConfirmPassword" type="password" class="field-input" autocomplete="new-password" />
                    <span class="field-validation text-danger" asp-validation-for="Input.ConfirmPassword"></span>
                </div>

                <div class="summary-wrap text-danger" asp-validation-summary="ModelOnly"></div>

                <button class="btn-login" type="submit">Update Password</button>

                <a class="btn-ghost" asp-page="/Hrms/EmployeeManagement/Index">Cancel</a>

                <div class="footnote">
                    After updating, you will be signed out and asked to sign in again.
                </div>
            </form>
        </section>
    </main>

    <footer class="login-footer">
        <span>© @DateTime.Now.Year HRMS</span>
        <span class="sep">•</span>
        <span>All rights reserved</span>
    </footer>
</div>

<partial name="_ValidationScriptsPartial" />